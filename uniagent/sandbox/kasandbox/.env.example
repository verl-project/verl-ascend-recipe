# Copy outside the checkout, chmod 600, edit, then set SANDBOX_ENV_FILE.
UNI_AGENT_ROOT=/workspace/kasandbox-uni-agent
VERL_SOURCE=/workspace/verl
MODEL_PATH=/models/Qwen3.5-9B
TRAIN_FILE=/data/kasandbox/train.parquet
TEST_FILE=/data/kasandbox/validation.parquet
EXP_NAME=kasandbox_qwen35_9b
E2B_API_KEY=
KASANDBOX_TUNNEL_MODE=ssh
KASANDBOX_SSH_TARGET=user@relay.example.com
KASANDBOX_SSH_PORT=22
KASANDBOX_REMOTE_API_PORT=29191
KASANDBOX_REMOTE_PROXY_PORT=29192
KASANDBOX_API_PORT=9191
KASANDBOX_PROXY_PORT=9192
CALLBACK_TUNNEL_ENABLED=true
CALLBACK_ADVERTISED_BASE_URL=http://pc.example.com:29193
CALLBACK_RELAY_PORT=29193
GATEWAY_COUNT=8
# installed requires claude already in every template's PATH.
CLAUDE_CODE_BINARY_MODE=installed
# For the original NFS mode, set all of these instead:
# CLAUDE_CODE_BINARY_MODE=nfs
# CLAUDE_CODE_NFS_SOURCE=nfs.example.com:/exports/claude-code
# CLAUDE_CODE_NFS_RELATIVE_BINARY=VERSION/linux-arm64/claude
# CLAUDE_CODE_NFS_BINARY_SHA256=...
# VC_WORKER_HOSTS=head.example.com,worker.example.com
# VC_TASK_INDEX=0
# LOCAL_IP=192.0.2.10
