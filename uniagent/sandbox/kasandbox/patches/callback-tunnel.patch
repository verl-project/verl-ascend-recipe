+++ b/uni_agent/gateway/callback_tunnel.py
@@ -0,0 +1,288 @@
+"""Per-gateway SSH callback relays, supervised through a parent-owned pipe.
+
+The supervisor has no Ray/torch dependencies. EOF on its stdin releases only
+its own SSH masters, including when the training driver is killed.
+"""
+
+from __future__ import annotations
+
+import atexit
+import ipaddress
+import json
+import logging
+import os
+import re
+import selectors
+import signal
+import subprocess
+import sys
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from urllib.parse import urlsplit, urlunsplit
+
+logger = logging.getLogger(__name__)
+
+
+def port(value: int) -> int:
+    if type(value) is not int or not 1 <= value <= 65535:
+        raise ValueError("Callback ports must be integers in 1..65535")
+    return value
+
+
+@dataclass(frozen=True)
+class CallbackRelayConfig:
+    ssh_target: str
+    ssh_port: int
+    relay_port: int
+    advertised_base_url: str
+
+    def __post_init__(self):
+        if not self.ssh_target or self.ssh_target.startswith("-") or any(c.isspace() for c in self.ssh_target):
+            raise ValueError("Invalid callback SSH target")
+        port(self.ssh_port)
+        port(self.relay_port)
+        url = urlsplit(self.advertised_base_url)
+        if (
+            url.scheme not in {"http", "https"}
+            or not url.hostname
+            or url.username
+            or url.password
+            or url.path not in {"", "/"}
+            or url.query
+            or url.fragment
+        ):
+            raise ValueError("Callback advertised URL must be an HTTP(S) origin")
+        port(url.port if url.port is not None else (443 if url.scheme == "https" else 80))
+
+    @classmethod
+    def from_environment(cls):
+        enabled = os.environ.get("CALLBACK_TUNNEL_ENABLED", "false")
+        if enabled not in {"true", "false"}:
+            raise ValueError("CALLBACK_TUNNEL_ENABLED must be true or false")
+        if enabled == "false":
+            return None
+        return cls(
+            ssh_target=os.environ["CALLBACK_RELAY_SSH_TARGET"],
+            ssh_port=int(os.environ.get("CALLBACK_RELAY_SSH_PORT", "22222")),
+            relay_port=int(os.environ["CALLBACK_RELAY_PORT"]),
+            advertised_base_url=os.environ["CALLBACK_ADVERTISED_BASE_URL"],
+        )
+
+    def routes(self, count: int) -> list[dict]:
+        if type(count) is not int or count <= 0:
+            raise ValueError("gateway_count must be a positive integer")
+        url = urlsplit(self.advertised_base_url)
+        first_port = url.port if url.port is not None else (443 if url.scheme == "https" else 80)
+        port(first_port + count - 1)
+        port(self.relay_port + count - 1)
+        host = f"[{url.hostname}]" if ":" in url.hostname else url.hostname
+        return [
+            {
+                "index": i,
+                "relay_port": self.relay_port + i,
+                "advertised_base_url": urlunsplit((url.scheme, f"{host}:{first_port + i}", "", "", "")),
+            }
+            for i in range(count)
+        ]
+
+
+def _forwarding_host(host: str) -> str:
+    """Format a literal IP or validated DNS name; SSH resolves names on the training client."""
+    if not isinstance(host, str) or not host or not host.isascii() or any(c.isspace() for c in host):
+        raise ValueError("Callback host must be an IP address or valid ASCII DNS hostname")
+    try:
+        address = ipaddress.ip_address(host)
+    except ValueError:
+        # Ray may return a platform FQDN. Preserve it, including an optional DNS root dot.
+        name = host[:-1] if host.endswith(".") else host
+        if (
+            not name
+            or len(name) > 253
+            or any(
+                re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label) is None
+                for label in name.split(".")
+            )
+        ):
+            raise ValueError("Callback host must be an IP address or valid ASCII DNS hostname") from None
+        return host
+    scope = getattr(address, "scope_id", None)
+    if scope is not None and re.fullmatch(r"[A-Za-z0-9_.-]+", scope) is None:
+        raise ValueError("Invalid callback IPv6 scope identifier")
+    return f"[{address}]" if address.version == 6 else str(address)
+
+
+def forwarding_spec(route: dict) -> str:
+    host = _forwarding_host(route["host"])
+    return f"127.0.0.1:{port(route['relay_port'])}:{host}:{port(route['port'])}"
+
+
+class CallbackTunnelPool:
+    """Own a supervisor; completion of start() is the relay readiness barrier."""
+
+    def __init__(self, config: CallbackRelayConfig, routes: list[dict]):
+        self.config = config
+        self.routes = routes
+        self.process = None
+
+    def start(self):
+        for route in self.routes:
+            forwarding_spec(route)
+        self.process = subprocess.Popen(
+            [sys.executable, "-m", "uni_agent.gateway.callback_tunnel", "--supervise"],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+        atexit.register(self.close)
+        try:
+            payload = {"ssh_target": self.config.ssh_target, "ssh_port": self.config.ssh_port, "routes": self.routes}
+            self.process.stdin.write(json.dumps(payload) + "\n")
+            self.process.stdin.flush()
+            with selectors.DefaultSelector() as selector:
+                selector.register(self.process.stdout, selectors.EVENT_READ)
+                if not selector.select(timeout=45 * len(self.routes) + 10):
+                    raise RuntimeError("Timed out starting gateway callback relays")
+            if self.process.stdout.readline().strip() != "ready":
+                raise RuntimeError("Gateway callback relay startup failed; inspect SSH stderr")
+            self.check()
+            for route in self.routes:
+                logger.info(
+                    "Callback gateway %s: %s -> relay 127.0.0.1:%s -> %s:%s",
+                    route["index"],
+                    route["advertised_base_url"],
+                    route["relay_port"],
+                    route["host"],
+                    route["port"],
+                )
+        except BaseException:
+            self.close()
+            raise
+
+    def check(self):
+        if self.process is None or self.process.poll() is not None:
+            raise RuntimeError("Gateway callback relay supervisor is not running")
+
+    def close(self):
+        process, self.process = self.process, None
+        if process is None:
+            return
+        atexit.unregister(self.close)
+        try:
+            process.stdin.close()
+            process.wait(timeout=10 + 6 * len(self.routes))
+        except (OSError, subprocess.TimeoutExpired):
+            process.terminate()
+            try:
+                process.wait(timeout=10 + 6 * len(self.routes))
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+        finally:
+            process.stdout.close()
+
+
+def _supervise():
+    def interrupted(signum, frame):
+        raise SystemExit(128 + signum)
+
+    signal.signal(signal.SIGTERM, interrupted)
+    signal.signal(signal.SIGINT, interrupted)
+    payload = json.loads(sys.stdin.readline())
+    target = payload["ssh_target"]
+    ssh_port = port(payload["ssh_port"])
+    controls = []
+    # A short path avoids AF_UNIX's socket-name limit, and stays in the user mount.
+    user_root = Path(os.environ.get("CALLBACK_CONTROL_ROOT", str(Path.home()))).resolve()
+    with tempfile.TemporaryDirectory(prefix=".cb-", dir=user_root) as directory:
+        try:
+            for i, route in enumerate(payload["routes"]):
+                control = str(Path(directory) / str(i))
+                if len(control.encode()) >= 100:
+                    raise ValueError("Callback SSH control path is too long")
+                controls.append(control)
+                env = os.environ.copy()
+                password = env.pop("CALLBACK_SSH_PASSWORD", "")
+                auth = ["sshpass", "-e"] if password else []
+                if password:
+                    env["SSHPASS"] = password
+                subprocess.run(
+                    [
+                        *auth,
+                        "ssh",
+                        "-o",
+                        "StrictHostKeyChecking=yes",
+                        "-o",
+                        "ExitOnForwardFailure=yes",
+                        "-o",
+                        "ServerAliveInterval=30",
+                        "-o",
+                        "ServerAliveCountMax=3",
+                        "-o",
+                        "ConnectTimeout=15",
+                        "-o",
+                        "ControlPersist=no",
+                        "-M",
+                        "-S",
+                        control,
+                        "-f",
+                        "-N",
+                        "-T",
+                        "-p",
+                        str(ssh_port),
+                        "-R",
+                        forwarding_spec(route),
+                        target,
+                    ],
+                    env=env,
+                    stdin=subprocess.DEVNULL,
+                    stdout=subprocess.DEVNULL,
+                    check=True,
+                    timeout=40,
+                )
+                subprocess.run(
+                    ["ssh", "-S", control, "-O", "check", target],
+                    stdin=subprocess.DEVNULL,
+                    stdout=subprocess.DEVNULL,
+                    check=True,
+                    timeout=5,
+                )
+            print("ready", flush=True)
+            # select() checks the pipe without buffering away EOF. Periodically
+            # detect dead masters so subsequent session creation fails promptly.
+            with selectors.DefaultSelector() as selector:
+                selector.register(sys.stdin, selectors.EVENT_READ)
+                while not selector.select(timeout=10):
+                    for control in controls:
+                        subprocess.run(
+                            ["ssh", "-S", control, "-O", "check", target],
+                            stdin=subprocess.DEVNULL,
+                            stdout=subprocess.DEVNULL,
+                            stderr=subprocess.DEVNULL,
+                            check=True,
+                            timeout=5,
+                        )
+        finally:
+            for control in reversed(controls):
+                try:
+                    subprocess.run(
+                        ["ssh", "-S", control, "-O", "exit", target],
+                        stdin=subprocess.DEVNULL,
+                        stdout=subprocess.DEVNULL,
+                        stderr=subprocess.DEVNULL,
+                        timeout=5,
+                        check=False,
+                    )
+                except (OSError, subprocess.TimeoutExpired):
+                    logger.warning("Could not close callback control socket %s", control)
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] != ["--supervise"]:
+        raise SystemExit("This module is started by GatewayManager; do not launch fixed callback tunnels")
+    try:
+        _supervise()
+    except (OSError, ValueError, subprocess.SubprocessError) as exc:
+        print(f"Callback relay supervisor failed: {type(exc).__name__}", file=sys.stderr)
+        raise SystemExit(1) from None
