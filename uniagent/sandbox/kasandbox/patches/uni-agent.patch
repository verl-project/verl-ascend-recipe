+"""Opt-in, stdlib-only wall-clock spans; never record commands, prompts or credentials."""
+from __future__ import annotations
+
+import argparse
+import contextvars
+import json
+import os
+import socket
+import sys
+import threading
+import time
+import uuid
+from pathlib import Path
+
+_context = contextvars.ContextVar("training_timing_context", default={})
+_parent = contextvars.ContextVar("training_timing_parent", default=None)
+_lock = threading.Lock()
+_warned = False
+_writer_key = None
+_writer_path = None
+_ALLOWED = {
+    "session_id", "episode_id", "instance_id", "sample_index", "sandbox_id", "sandbox_attempt_id", "attempt",
+    "request_id", "uid", "step", "partition", "role", "provider", "node_index", "exit_code", "finished",
+}
+
+
+def _metadata(values):
+    return {key: value for key, value in values.items()
+            if key in _ALLOWED and isinstance(value, (str, int, float, bool, type(None)))}
+
+
+def emit(record):
+    """Append one small event to a file owned by this process. Fail open on I/O errors."""
+    global _warned, _writer_key, _writer_path
+    directory = os.environ.get("TRAINING_TIMING_DIR")
+    if not directory:
+        return
+    try:
+        host, pid = socket.gethostname(), os.getpid()
+        key = (directory, host, pid)
+        with _lock:
+            if key != _writer_key:
+                Path(directory).mkdir(parents=True, exist_ok=True)
+                _writer_path = Path(directory) / f"events.{host}.{pid}.{uuid.uuid4().hex}.jsonl"
+                _writer_key = key
+            event = {
+                "schema": 1, "run_id": os.getenv("TRAINING_TIMING_RUN_ID", ""),
+                "host": host, "pid": pid, "rank": os.getenv("RANK", os.getenv("LOCAL_RANK", "")),
+                **record,
+            }
+            data = (json.dumps(event, ensure_ascii=True, allow_nan=False) + "\n").encode()
+            fd = os.open(_writer_path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+            try:
+                offset = 0
+                while offset < len(data):
+                    offset += os.write(fd, data[offset:])
+            finally:
+                os.close(fd)
+    except (OSError, ValueError, TypeError):
+        if not _warned:
+            _warned = True
+            print("training timing: event write failed; timing data may be incomplete", file=sys.stderr)
+
+
+class phase:
+    """Context manager for sync/async code; durations use a local monotonic clock."""
+
+    def __init__(self, name, **metadata):
+        self.name = name
+        self.metadata = metadata
+        self.active = False
+
+    def __enter__(self):
+        self.active = bool(os.environ.get("TRAINING_TIMING_DIR"))
+        if not self.active:
+            return self
+        self.span_id = uuid.uuid4().hex
+        self.start_ns = time.time_ns()
+        self.mono_ns = time.monotonic_ns()
+        self.values = _metadata({**_context.get(), **self.metadata})
+        if self.name == "episode":
+            self.values.setdefault("episode_id", self.values.get("session_id") or uuid.uuid4().hex)
+        self.record = {
+            "event": "begin", "span_id": self.span_id, "parent_id": _parent.get(),
+            "phase": self.name, "wall_ns": self.start_ns, "monotonic_ns": self.mono_ns,
+            "metadata": self.values,
+        }
+        emit(self.record)
+        self.context_token = _context.set(self.values)
+        self.parent_token = _parent.set(self.span_id)
+        return self
+
+    def update(self, **metadata):
+        """Attach identifiers learned after begin (for example the allocated sandbox ID)."""
+        if self.active:
+            self.values.update(_metadata(metadata))
+
+    def __exit__(self, exc_type, exc, tb):
+        if self.active:
+            duration = time.monotonic_ns() - self.mono_ns
+            emit({
+                **self.record, "event": "end", "wall_ns": time.time_ns(),
+                "duration_ns": duration,
+                "status": "ok" if exc_type is None and self.values.get("exit_code", 0) == 0 else "error",
+                "error_type": None if exc_type is None else exc_type.__name__,
+            })
+            _parent.reset(self.parent_token)
+            _context.reset(self.context_token)
+        return False
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=("job-start", "job-end"))
+    parser.add_argument("--exit-code", type=int, default=0)
+    args = parser.parse_args()
+    directory = Path(os.environ["TRAINING_TIMING_DIR"])
+    state = directory / "job-state.json"
+    if args.action == "job-start":
+        directory.mkdir(parents=True, exist_ok=True)
+        record = {
+            "event": "begin", "span_id": uuid.uuid4().hex, "parent_id": None,
+            "phase": "job", "wall_ns": time.time_ns(), "monotonic_ns": time.monotonic_ns(),
+            "metadata": {"node_index": 0},
+        }
+        with state.open("x", encoding="utf-8") as stream:
+            json.dump(record, stream)
+        state.chmod(0o600)
+        emit(record)
+    else:
+        record = json.loads(state.read_text())
+        emit({
+            **record, "event": "end", "wall_ns": time.time_ns(),
+            "duration_ns": time.monotonic_ns() - record["monotonic_ns"],
+            "status": "ok" if args.exit_code == 0 else "error",
+            "metadata": {**record["metadata"], "exit_code": args.exit_code},
+        })
+
+
+if __name__ == "__main__":
+    main()
