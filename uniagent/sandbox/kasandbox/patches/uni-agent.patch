+    async def _mount_claude(self, sandbox: Sandbox, cfg: ClaudeCodeConfig) -> None:
+        """Use the guest's own host export; never upload or rewrite the shared executable."""
+        mount = shlex.quote(cfg.nfs_mount_path)
+        source = shlex.quote(cfg.nfs_source)
+        binary = shlex.quote(str(PurePosixPath(cfg.nfs_mount_path) / cfg.nfs_relative_binary))
+        script = f"""set -euo pipefail
+sudo -n mkdir -p -- {mount}
+if ! mountpoint -q -- {mount}; then
+  sudo -n timeout 30 mount -t nfs -o ro,vers=3,proto=tcp,nolock,nosuid,nodev {source} {mount}
+fi
+[ "$(findmnt -rn -o SOURCE --mountpoint {mount})" = {source} ]
+case ",$(findmnt -rn -o OPTIONS --mountpoint {mount})," in
+  *,ro,*) ;;
+  *) echo 'Claude NFS mount is not read-only' >&2; exit 1 ;;
+esac
+test -x {binary}
+"""
+        with timing_phase("claude_nfs_mount"):
+            result = await sandbox.exec_shell(script, timeout=45)
+            if result.exit_code != 0:
+                raise RuntimeError("claude_code: read-only NFS mount failed; check guest NFS support and host export")
+        check = f"test -x {binary}; "
+        if cfg.nfs_binary_sha256:
+            check += f"printf '%s  %s\n' {shlex.quote(cfg.nfs_binary_sha256.lower())} {binary} | sha256sum -c -; "
+        check += f"{binary} --version"
+        with timing_phase("claude_binary_check"):
+            result = await sandbox.exec_shell(
+                "set -euo pipefail; " + check, timeout=120,
+                env={"DISABLE_AUTOUPDATER": "1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"},
+            )
+            if result.exit_code != 0:
+                raise RuntimeError("claude_code: NFS binary checksum/version check failed")
+        self._private_home = f"/tmp/uni-agent-claude-{uuid.uuid4().hex}"
+        result = await sandbox.exec(["mkdir", "-m", "0700", "-p", self._private_home], timeout=30)
+        if result.exit_code != 0:
+            raise RuntimeError("claude_code: cannot create private guest home")
+
+    async def _upload_claude(self, sandbox: Sandbox, cfg: ClaudeCodeConfig) -> None:
+        assert cfg.local_binary_path is not None
+        source = Path(cfg.local_binary_path).expanduser()
+        if not source.is_absolute() or not source.is_file():
+            raise ValueError(
+                f"claude_code: local_binary_path must be an existing absolute file on this worker: {source}"
+            )
+
+        def checksum() -> str:
+            digest = hashlib.sha256()
+            with source.open("rb") as stream:
+                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                    digest.update(chunk)
+            return digest.hexdigest()
+
+        digest = await asyncio.to_thread(checksum)
+        if cfg.local_binary_sha256 and digest != cfg.local_binary_sha256.lower():
+            raise ValueError(f"claude_code: local binary SHA-256 mismatch: {source}")
+        temporary = f"/usr/local/bin/.claude-upload-{uuid.uuid4().hex}"
+        logger.info("claude_code: uploading %s (sha256=%s)", source, digest)
+        try:
+            result = await sandbox.exec_shell("mkdir -p /usr/local/bin", timeout=30)
+            if result.exit_code != 0:
+                raise RuntimeError(f"claude_code: cannot prepare binary directory: {result.stderr}")
+            await sandbox.upload_file(source, temporary)
+            result = await sandbox.exec_shell(
+                f"set -e; printf '%s  %s\n' '{digest}' '{temporary}' | sha256sum -c -; "
+                f"chmod 0755 '{temporary}'; '{temporary}' --version; "
+                f"mv -f '{temporary}' /usr/local/bin/claude",
+                env={"DISABLE_AUTOUPDATER": "1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"},
+                timeout=60,
+            )
+            if result.exit_code != 0:
+                detail = (result.stderr or result.stdout or "unknown error").strip()[-2000:]
+                raise RuntimeError(f"claude_code: uploaded binary verification failed: {detail}")
+            logger.info("claude_code: uploaded binary ready: %s", result.stdout.strip())
+        finally:
+            try:
+                await sandbox.exec_shell(f"rm -f '{temporary}'", timeout=30)
+            except Exception:
+                logger.warning("claude_code: could not remove temporary upload %s", temporary, exc_info=True)
+
