# Copy outside the checkout, chmod 600, edit, then set SANDBOX_ENV_FILE.
# Both workers must see the same source, model and dataset paths.
UNI_AGENT_ROOT=/workspace/agentenv-uni-agent
VERL_SOURCE=/workspace/verl
MODEL_PATH=/models/Qwen3.5-9B
TRAIN_DATA=/data/agentenv/train.parquet
VAL_DATA=/data/agentenv/validation.parquet
EXP_NAME=agentenv_qwen35_9b
E2B_API_KEY=
AGENTENV_RELAY_TARGET=user@relay.example.com
AGENTENV_RELAY_SSH_PORT=22
AGENTENV_HOST=agentenv.example.com
AGENTENV_ASSET_URL=http://agentenv.example.com:40192
CLAUDE_CODE_SHA256=
GATEWAY_COUNT=8
# Defaults align with start_agentenv_bridge.ps1; reserve every gateway port.
AGENTENV_API_PORT=40190
AGENTENV_RELAY_API_PORT=40191
AGENTENV_CALLBACK_PORT=40193
AGENTENV_RELAY_CALLBACK_PORT=30193
# For Java tasks only: readable archive containing Maven repository/.
# AGENTENV_JAVA_M2_ARCHIVE=/data/assets/java-m2.tar.gz
# Platform may already supply these; index differs on each worker.
# VC_WORKER_HOSTS=head.example.com,worker.example.com
# VC_TASK_INDEX=0
# LOCAL_IP=192.0.2.10
# SSH_KNOWN_HOSTS=/home/train/.ssh/known_hosts
