+        # replay then serves wrong expert ids for them. The condition is
+        # rank-invariant, so every TP rank gathers in lockstep.
+        if self.tp_size > 1 and _EXTRA_CTX.moe_comm_type in _TP_SHARDED_COMM_TYPES:
