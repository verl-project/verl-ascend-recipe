diff --git a/verl/utils/kimi_expert_stream.py b/verl/utils/kimi_expert_stream.py
new file mode 100644
index 00000000..3a3fc80d
--- /dev/null
+++ b/verl/utils/kimi_expert_stream.py
@@ -0,0 +1,78 @@
+# Copyright 2026 Bytedance Ltd. and/or its affiliates
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded Kimi expert tiles on the existing named-tensor checkpoint wire."""
+
+TILE_MARKER = ".__verl_expert_tile__."
+EXPERT_MARKER = ".__verl_streamed_expert__."
+LOCAL_MARKER = ".__verl_packed_local__."
+
+
+def expert_tile_name(name, expert, rows, columns, row, column, num_experts=1):
+    return f"{name}{TILE_MARKER}{expert}.{num_experts}.{rows}.{columns}.{row}.{column}"
+
+
+def parse_expert_tile(name):
+    if TILE_MARKER not in name:
+        return None
+    base, encoded = name.rsplit(TILE_MARKER, 1)
+    values = encoded.split(".")
+    if len(values) != 6 or not all(value.isdecimal() for value in values):
+        raise ValueError(f"Invalid Kimi expert tile name: {name}")
+    expert, num_experts, rows, columns, row, column = map(int, values)
+    if min(rows, columns) <= 0 or expert >= num_experts or row >= rows or column >= columns:
+        raise ValueError(f"Invalid Kimi expert tile bounds: {name}")
+    return base, expert, num_experts, rows, columns, row, column
+
+
+async def merge_expert_tiles(weights):
+    """Reconstruct one expert, never the global packed parameter.
+
+    Tiles for an expert are contiguous in the stream. Validate coverage without
+    allocating a per-element mask, and copy out of reusable transport buckets.
+    """
+    pending, buffer, covered = None, None, 0
+    rectangles = []
+    progress = {}
+    async for name, tensor in weights:
+        tile = parse_expert_tile(name)
+        if tile is None:
+            if pending is not None:
+                raise ValueError(f"Incomplete Kimi expert before {name}: {pending}")
+            yield name, tensor
+            continue
+        base, expert, num_experts, rows, columns, row, column = tile
+        key = base, expert, rows, columns
+        if tensor.ndim != 2 or tensor.numel() == 0:
+            raise ValueError(f"Kimi expert tile must be a nonempty matrix: {name}")
+        height, width = tensor.shape
+        if row + height > rows or column + width > columns:
+            raise ValueError(f"Kimi expert tile exceeds matrix bounds: {name}")
+        if pending is None:
+            expected, total = progress.get(base, (0, num_experts))
+            if expert != expected or total != num_experts:
+                raise ValueError(f"Missing, duplicate or inconsistent Kimi expert: {name}")
+            progress[base] = expected, total
+            pending = key
+            buffer = tensor.new_empty((1, rows, columns))
+        if key != pending or tensor.dtype != buffer.dtype or tensor.device != buffer.device:
+            raise ValueError(f"Inconsistent or incomplete Kimi expert tiles: {name}, pending={pending}")
+        for previous_row, previous_column, previous_height, previous_width in rectangles:
+            if (
+                row < previous_row + previous_height
+                and previous_row < row + height
+                and column < previous_column + previous_width
+                and previous_column < column + width
+            ):
+                raise ValueError(f"Overlapping Kimi expert tile: {name}")
+        buffer[0, row : row + height, column : column + width].copy_(tensor)
+        rectangles.append((row, column, height, width))
+        covered += tensor.numel()
+        if covered == rows * columns:
+            yield f"{base}{EXPERT_MARKER}{expert}", buffer
+            progress[base] = expert + 1, num_experts
+            pending, buffer, covered = None, None, 0
+            rectangles = []
+    if pending is not None:
+        raise ValueError(f"Incomplete Kimi expert at end of stream: {pending}")
+    if any(received != total for received, total in progress.values()):
+        raise ValueError(f"Missing Kimi experts at end of stream: {progress}")
diff --git a/verl/workers/engine/fsdp/kimi_packed_weights.py b/verl/workers/engine/fsdp/kimi_packed_weights.py
index 9d8e7e74..5097b46e 100644
--- a/verl/workers/engine/fsdp/kimi_packed_weights.py
+++ b/verl/workers/engine/fsdp/kimi_packed_weights.py
@@ -8,10 +8,78 @@ import torch.distributed as dist
 from torch.distributed.tensor import DTensor, Replicate, Shard
 from torch.distributed.tensor._utils import compute_local_shape_and_global_offset
 
+from verl.utils.kimi_expert_stream import expert_tile_name
+
 KIMI_PACKED_LOCAL_MARKER = ".__verl_packed_local__."
 _RESHARD_BUFFER_BYTES = 64 * 1024 * 1024
 
 
+@lru_cache(maxsize=32)
+def _source_shards(shape, mesh_shape, ranks, shard_dims):
+    """Choose one owner of each disjoint physical shard, excluding replicas."""
+    owners = {}
+    for rank, coordinate in zip(ranks, product(*(range(size) for size in mesh_shape)), strict=True):
+        sizes, offsets = list(shape), [0, 0, 0]
+        for dim, size, index in zip(shard_dims, mesh_shape, coordinate, strict=True):
+            if dim >= 0:
+                chunk = (sizes[dim] + size - 1) // size
+                offset = min(index * chunk, sizes[dim])
+                offsets[dim] += offset
+                sizes[dim] = min(chunk, sizes[dim] - offset)
+        if all(sizes):
+            owners.setdefault((*offsets, *sizes), rank)
+    return tuple((*bounds, owner) for bounds, owner in sorted(owners.items()))
+
+
+def stream_kimi_packed_param(name, param, device, max_tile_bytes=_RESHARD_BUFFER_BYTES):
+    """Export all experts through bounded actor-group broadcasts.
+
+    Every actor walks the same collective sequence. The checkpoint engine's
+    rank 0 forwards the tiles; other actors consume them as before. CPU-offloaded
+    shards are staged a tile at a time, without DTensor.to()/full_tensor().
+    """
+    if not isinstance(param, DTensor) or param.ndim != 3:
+        raise TypeError(f"Kimi expert streaming requires a 3-D DTensor: {name}")
+    if max_tile_bytes < param.element_size():
+        raise ValueError("Kimi expert tile budget is smaller than one element")
+    mesh = param.device_mesh
+    ranks = tuple(mesh.mesh.flatten().tolist())
+    if sorted(ranks) != list(range(dist.get_world_size())):
+        raise ValueError("Kimi expert streaming requires the full actor mesh")
+    if any(not isinstance(p, (Shard, Replicate)) for p in param.placements):
+        raise ValueError("Kimi expert streaming requires Shard/Replicate placements")
+    dims = tuple(p.dim if isinstance(p, Shard) else -1 for p in param.placements)
+    if any(dim not in (-1, 0, 1, 2) for dim in dims):
+        raise ValueError("Invalid Kimi expert sharding dimension")
+    shards = _source_shards(tuple(param.shape), tuple(mesh.shape), ranks, dims)
+    local = param.to_local().detach()
+    rank = dist.get_rank()
+    elements = max_tile_bytes // param.element_size()
+    for expert in range(param.shape[0]):
+        for expert_start, row_start, column_start, count, rows, columns, source in shards:
+            if not expert_start <= expert < expert_start + count:
+                continue
+            tile_columns = min(columns, elements)
+            tile_rows = max(1, elements // tile_columns)
+            for row in range(0, rows, tile_rows):
+                height = min(tile_rows, rows - row)
+                for column in range(0, columns, tile_columns):
+                    width = min(tile_columns, columns - column)
+                    tile = torch.empty((height, width), dtype=param.dtype, device=device)
+                    if rank == source:
+                        tile.copy_(local[expert - expert_start, row : row + height, column : column + width])
+                    dist.broadcast(tile, src=source)
+                    yield expert_tile_name(
+                        name,
+                        expert,
+                        param.shape[1],
+                        param.shape[2],
+                        row_start + row,
+                        column_start + column,
+                        num_experts=param.shape[0],
+                    ), tile
+
+
 @lru_cache(maxsize=32)
 def _reshard_plan(shape, mesh_shape, ranks, shard_dims, target_ep, rank, element_size, buffer_bytes):
     """Plan disjoint expert/matrix tiles; no weight or metadata gather is needed."""
