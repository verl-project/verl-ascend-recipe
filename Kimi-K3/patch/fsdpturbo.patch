+# Copyright (c) 2026, Huawei Technologies Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+
+from collections.abc import Sequence
+
+import torch
+
+from fsdp_turbo.ops.registry import dispatch_op
+
+
+def canonical_nd(tensor: torch.Tensor) -> torch.Tensor:
+    """Return canonical storage while preserving gradients."""
+    return dispatch_op("canonical_nd", tensor, device_type=tensor.device.type)
+
+
+def try_fused_vision_attention(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor | None:
+    """Return fused no-grad attention, or None for the portable caller path."""
+    return dispatch_op(
+        "try_fused_vision_attention",
+        q,
+        k,
+        v,
+        cu_seqlens,
+        scale,
+        device_type=q.device.type,
+    )
+
+
+def vision_attention(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_cu_seqlens: torch.Tensor | Sequence[int],
+    k_cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor:
+    """Compute non-causal attention over packed vision sequences."""
+    return dispatch_op(
+        "vision_attention",
+        q,
+        k,
+        v,
+        q_cu_seqlens,
+        k_cu_seqlens,
+        scale,
+        device_type=q.device.type,
+    )
+
+
+def rotary_interleaved(inputs: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """Apply rotary embeddings to adjacent feature pairs."""
+    return dispatch_op(
+        "rotary_interleaved", inputs, cos, sin, device_type=inputs.device.type
+    )
diff --git a/tests/unit_tests/models/test_kimi_projector.py b/tests/unit_tests/models/test_kimi_projector.py
new file mode 100644
index 0000000..c56d3d1
--- /dev/null
+++ b/tests/unit_tests/models/test_kimi_projector.py
@@ -0,0 +1,71 @@
+# Copyright (c) 2026, Huawei Technologies Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+
+import ast
+import math
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn.functional as F
+from transformers import PretrainedConfig
+
+# This Hugging Face model file imports configuration modules supplied by the
+# checkpoint. Exercise its self-contained projector classes without a checkpoint.
+source = Path(__file__).resolve().parents[3] / "fsdp_turbo/models/kimi/modeling_kimi_k3.py"
+definitions = [
+    node for node in ast.parse(source.read_text()).body
+    if isinstance(node, ast.ClassDef) and node.name in {"PatchMergerMLPV2", "ProjectorConfig", "VisionTowerConfig"}
+]
+namespace = {"torch": torch, "nn": torch.nn, "math": math, "KimiK3Config": SimpleNamespace}
+namespace["PretrainedConfig"] = PretrainedConfig
+exec(compile(ast.Module(body=definitions, type_ignores=[]), str(source), "exec"), namespace)  # noqa: S102 - compile only local projector definitions
+PatchMergerMLPV2 = namespace["PatchMergerMLPV2"]
+ProjectorConfig = namespace["ProjectorConfig"]
+
+
+@pytest.mark.parametrize("checkpoint_mode", ["bilinear", "bicubic"])
+def test_vision_interpolation_matches_reference(checkpoint_mode):
+    config = SimpleNamespace(
+        patch_size=14, init_pos_emb_height=2, init_pos_emb_width=2, init_pos_emb_time=1,
+        pos_emb_type="learnable", vt_num_attention_heads=1, vt_num_hidden_layers=1,
+        vt_hidden_size=4, vt_intermediate_size=8, merge_kernel_size=(2, 2),
+        merge_type="spatial", _attn_implementation="eager",
+        pos_emb_interpolation_mode=checkpoint_mode,
+    )
+    assert namespace["VisionTowerConfig"](config).pos_emb_interpolation_mode == "bicubic"
+
+
+@pytest.mark.parametrize("use_rotation", [False, True])
+@pytest.mark.parametrize("ragged", [False, True])
+def test_projector_checkpoint_rotation_and_backward(use_rotation, ragged):
+    config = ProjectorConfig(SimpleNamespace(
+        mm_projector_type="patchmergerv2", mm_hidden_size=2, text_hidden_size=8,
+        merge_kernel_size=(2, 2), projector_hidden_act="gelu",
+        projector_ln_eps=1e-6, use_rot_proj=use_rotation,
+    ))
+    model = PatchMergerMLPV2(config)
+    state = model.state_dict()
+    rotation = torch.eye(8).roll(1, dims=0)
+    if use_rotation:
+        state["rot_proj.weight"] = rotation
+    else:
+        assert "rot_proj.weight" not in state
+    model.load_state_dict(state, strict=True)
+
+    features = torch.randn(3, 4, 2, requires_grad=True)
+    inputs = [features[:1], features[1:]] if ragged else features.unsqueeze(0)
+    output = model(inputs)
+    actual = torch.cat(output) if ragged else output.squeeze(0)
+    expected = model.post_norm(model.proj(features.flatten(1)))
+    if use_rotation:
+        expected = F.linear(expected, rotation)
+    torch.testing.assert_close(actual, expected)
+    actual.square().sum().backward()
+    assert features.grad is not None and torch.isfinite(features.grad).all()
+    if use_rotation:
+        assert model.rot_proj.weight.grad is not None
+        assert torch.isfinite(model.rot_proj.weight.grad).all()
+        assert model.rot_proj.weight.grad.abs().sum() > 0
+        assert torch.equal(model.state_dict()["rot_proj.weight"], rotation)
