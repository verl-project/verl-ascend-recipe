+++ b/tests/unit_tests/ops/test_vision.py
@@ -0,0 +1,42 @@
+"""Portable vision operators preserve packed sequence boundaries and RoPE."""
+
+import torch
+import torch.nn.functional as F
+from fsdp_turbo.ops.vision import canonical_nd, rotary_interleaved, vision_attention
+
+
+def test_packed_attention_keeps_images_independent():
+    generator = torch.Generator().manual_seed(7)
+    query, key, value = [torch.randn(5, 2, 4, generator=generator) for _ in range(3)]
+    actual = vision_attention(query, key, value, [0, 2, 5], [0, 2, 5], 0.5)
+    expected = torch.cat(
+        [
+            F.scaled_dot_product_attention(
+                query[start:end].transpose(0, 1),
+                key[start:end].transpose(0, 1),
+                value[start:end].transpose(0, 1),
+                scale=0.5,
+            ).transpose(0, 1)
+            for start, end in [(0, 2), (2, 5)]
+        ]
+    )
+    torch.testing.assert_close(actual, expected)
+
+
+def test_rotary_interleaved_matches_complex_rotation_and_gradients():
+    inputs = torch.randn(3, 2, 8, requires_grad=True)
+    angles = torch.randn(3, 1, 4)
+    cos, sin = [
+        values.repeat_interleave(2, dim=-1) for values in (angles.cos(), angles.sin())
+    ]
+    output = rotary_interleaved(inputs, cos, sin)
+    pairs = torch.view_as_complex(inputs.reshape(3, 2, 4, 2))
+    expected = torch.view_as_real(
+        pairs * torch.polar(torch.ones_like(angles), angles)
+    ).reshape_as(inputs)
+    torch.testing.assert_close(output, expected)
+    torch.testing.assert_close(
+        torch.autograd.grad(output.sum(), inputs, retain_graph=True)[0],
+        torch.autograd.grad(expected.sum(), inputs)[0],
+    )
+    assert canonical_nd(inputs) is inputs
