@@ -0,0 +1,72 @@
+"""Configuration-driven expert FSDP placement regression tests."""
+import pytest
+import torch
+
+from fsdp_turbo.fsdp_turbo_config import DistributedConfig, EPPlanConfig, FSDPTurboConfig, load_config_from_yaml
+from fsdp_turbo.distributed.expert_parallel.expert_fully_shard_parallel import _make_efsdp_shard_placement
+
+
+def make_experts():
+    module = torch.nn.Module()
+    module.register_parameter("gate_up_proj", torch.nn.Parameter(torch.empty(2, 8, 12)))
+    module.register_parameter("down_proj", torch.nn.Parameter(torch.empty(2, 6, 8)))
+    module.register_parameter("bias", torch.nn.Parameter(torch.empty(8)))
+    return module
+
+
+def test_yaml_pairs_are_normalized_and_select_parameter_dimensions(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("distributed:\n  ep_plan:\n    apply_modules: []\n    efsdp_shard_placements:\n      - [gate_up_proj, 2]\n      - [down_proj, 1]\n")
+    config = load_config_from_yaml(path)
+    plan = config.distributed.ep_plan
+    assert plan.efsdp_shard_placements == [("gate_up_proj", 2), ("down_proj", 1)]
+    experts = make_experts()
+    callback = _make_efsdp_shard_placement(experts, plan.efsdp_shard_placements, False)
+    assert callback(experts.gate_up_proj).dim == 2
+    assert callback(experts.down_proj).dim == 1
+    assert callback(experts.bias).dim == 0
+
+
+def test_configuration_can_swap_dimensions_without_model_changes():
+    experts = make_experts()
+    first = _make_efsdp_shard_placement(experts, [("gate_up_proj", 1), ("down_proj", 2)], False)
+    other = make_experts()
+    second = _make_efsdp_shard_placement(other, [("gate_up_proj", 2)], False)
+    assert first(experts.gate_up_proj).dim == 1
+    assert first(experts.down_proj).dim == 2
+    assert second(other.gate_up_proj).dim == 2
+    assert second(other.down_proj).dim == 1
+
+
+def test_defaults_and_low_precision_all_gather():
+    experts = make_experts()
+    callback = _make_efsdp_shard_placement(experts, [], False)
+    assert callback(experts.gate_up_proj).dim == 1
+    callback = _make_efsdp_shard_placement(experts, [("gate_up_proj", 0)], True)
+    assert callback(experts.gate_up_proj).dim == callback(experts.down_proj).dim == 0
+    with pytest.raises(ValueError, match="dim-0"):
+        _make_efsdp_shard_placement(experts, [("gate_up_proj", 2)], True)
+
+
+@pytest.mark.parametrize("placements", [None, {}, ["gate_up_proj"], [["gate_up_proj"]],
+    [["", 1]], [[4, 1]], [["gate_up_proj", -1]], [["gate_up_proj", True]],
+    [["gate_up_proj", 1.5]], [["gate_up_proj", 2, 3]],
+    [["gate_up_proj", 1], ["gate_up_proj", 2]]])
+def test_invalid_config_rejected_at_initialization(placements):
+    with pytest.raises(ValueError):
+        FSDPTurboConfig(distributed=DistributedConfig(ep_plan=EPPlanConfig(efsdp_shard_placements=placements)))
+
+
+def test_unknown_parameter_and_out_of_range_dimension():
+    experts = make_experts()
+    with pytest.raises(AttributeError):
+        _make_efsdp_shard_placement(experts, [("typo", 1)], False)
+    with pytest.raises(ValueError, match="out of range"):
+        _make_efsdp_shard_placement(experts, [("gate_up_proj", 3)], False)
+
+
+def test_shared_parameter_cannot_have_conflicting_dimensions():
+    experts = make_experts()
+    experts.alias = experts.gate_up_proj
+    with pytest.raises(ValueError, match="Conflicting"):
+        _make_efsdp_shard_placement(experts, [("gate_up_proj", 2), ("alias", 1)], False)
