@@ -0,0 +1,88 @@
+import importlib.util
+import itertools
+from pathlib import Path
+from typing import ClassVar
+
+import torch
+
+_MODULE_PATH = Path(__file__).parents[3] / "fsdp_turbo" / "ops" / "npu" / "grouped_matmul.py"
+_SPEC = importlib.util.spec_from_file_location("test_npu_grouped_matmul_impl", _MODULE_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+npu_grouped_matmul = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(npu_grouped_matmul)
+
+
+class _FakeTorchNPU:
+    calls: ClassVar[list] = []
+
+    @classmethod
+    def npu_grouped_matmul(
+        cls,
+        inputs,
+        weights,
+        *,
+        bias,
+        group_list,
+        split_item,
+        group_type,
+        group_list_type,
+    ):
+        cls.calls.append((inputs, weights, split_item, group_type, group_list_type))
+        assert bias is None
+        assert len(inputs) == 1
+        assert len(weights) == 1
+
+        sizes = group_list.tolist()
+        offsets = [0]
+        for size in sizes:
+            offsets.append(offsets[-1] + size)
+
+        if split_item == 2:
+            packed_weight = weights[0]
+            assert packed_weight.ndim == 3
+            output = [
+                inputs[0][start:end] @ packed_weight[expert_id]
+                for expert_id, (start, end) in enumerate(itertools.pairwise(offsets))
+            ]
+            return [torch.cat(output)]
+
+        assert split_item == 3
+        assert group_type == 2
+        input_transposed = inputs[0]
+        grad_output = weights[0]
+        output = [
+            input_transposed[:, start:end] @ grad_output[start:end]
+            for start, end in itertools.pairwise(offsets)
+        ]
+        return [torch.stack(output)]
+
+
+def test_grouped_matmul_uses_packed_3d_weight_and_preserves_gradients(monkeypatch):
+    monkeypatch.setattr(npu_grouped_matmul, "torch_npu", _FakeTorchNPU)
+    _FakeTorchNPU.calls.clear()
+
+    inputs = torch.randn(5, 3, dtype=torch.float64, requires_grad=True)
+    weights = torch.randn(2, 4, 3, dtype=torch.float64, requires_grad=True)
+    group_sizes = torch.tensor([2, 3], dtype=torch.int64)
+
+    output = npu_grouped_matmul.GroupedMatmul.apply(inputs, weights, None, group_sizes, 1)
+    output.square().sum().backward()
+
+    reference_inputs = inputs.detach().clone().requires_grad_()
+    reference_weights = weights.detach().clone().requires_grad_()
+    reference_output = torch.cat(
+        (
+            reference_inputs[:2] @ reference_weights[0].T,
+            reference_inputs[2:] @ reference_weights[1].T,
+        )
+    )
+    reference_output.square().sum().backward()
+
+    torch.testing.assert_close(output, reference_output)
+    torch.testing.assert_close(inputs.grad, reference_inputs.grad)
+    torch.testing.assert_close(weights.grad, reference_weights.grad)
+
+    forward_weight = _FakeTorchNPU.calls[0][1][0]
+    input_grad_weight = _FakeTorchNPU.calls[1][1][0]
+    assert forward_weight.shape == (2, 3, 4)
+    assert input_grad_weight.shape == (2, 4, 3)
