new file mode 100644
index 0000000..23d228f
--- /dev/null
+++ b/fsdp_turbo/ops/npu/vision.py
@@ -0,0 +1,112 @@
+# Copyright (c) 2026, Huawei Technologies Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+
+from collections.abc import Sequence
+
+import torch
+import torch.nn.functional as F
+import torch_npu
+
+from fsdp_turbo.ops.registry import register_op
+
+
+class _NpuCanonicalND(torch.autograd.Function):
+    """Canonicalize NPU storage format while preserving autograd."""
+
+    @staticmethod
+    def forward(ctx, tensor: torch.Tensor) -> torch.Tensor:
+        ctx.original_format = torch_npu.get_npu_format(tensor)
+        return torch_npu.npu_format_cast(tensor, 2)
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor) -> tuple[torch.Tensor]:
+        return (torch_npu.npu_format_cast(grad_output, ctx.original_format),)
+
+
+@register_op("canonical_nd", "npu")
+def canonical_nd_npu(tensor: torch.Tensor) -> torch.Tensor:
+    """Convert NPU storage to ND while preserving gradients."""
+    if tensor.device.type != "npu":
+        return tensor
+    if torch.is_grad_enabled() and tensor.requires_grad:
+        return _NpuCanonicalND.apply(tensor)
+    return torch_npu.npu_format_cast(tensor, 2)
+
+
+@register_op("try_fused_vision_attention", "npu")
+def try_fused_vision_attention_npu(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor | None:
+    """Match vLLM-Ascend vision attention during no-grad forwards."""
+    if q.device.type != "npu" or torch.is_grad_enabled():
+        return None
+
+    if isinstance(cu_seqlens, torch.Tensor):
+        seq_ends = cu_seqlens.detach().cpu().reshape(-1).tolist()
+    else:
+        seq_ends = [int(value) for value in cu_seqlens]
+    if seq_ends and seq_ends[0] == 0:
+        seq_ends = seq_ends[1:]
+    if not seq_ends or seq_ends[-1] != q.shape[0]:
+        return None
+
+    original_head_dim = q.shape[-1]
+    if 64 < original_head_dim < 128:
+        pad_len = 128 - original_head_dim
+        q = F.pad(q, (0, pad_len), value=0)
+        k = F.pad(k, (0, pad_len), value=0)
+        v = F.pad(v, (0, pad_len), value=0)
+
+    output, _ = torch_npu.npu_fused_infer_attention_score(
+        query=q.contiguous(),
+        key=k.contiguous(),
+        value=v.contiguous(),
+        atten_mask=None,
+        block_table=None,
+        input_layout="TND",
+        block_size=128,
+        actual_seq_lengths=seq_ends,
+        actual_seq_lengths_kv=seq_ends,
+        num_key_value_heads=q.shape[1],
+        num_heads=q.shape[1],
+        scale=scale,
+        sparse_mode=0,
+        pre_tokens=2147483647,
+        next_tokens=2147483647,
+    )
+    if original_head_dim != q.shape[-1]:
+        output = output[..., :original_head_dim]
+    return output.flatten(start_dim=-2)
+
+
+@register_op("vision_attention", "npu")
+def vision_attention_npu(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_cu_seqlens: torch.Tensor | Sequence[int],
+    k_cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor:
+    """Apply Ascend fused non-causal attention to packed image sequences."""
+    return torch_npu.npu_fusion_attention(
+        q,
+        k,
+        v,
+        head_num=q.shape[1],
+        pse=None,
+        scale=scale,
+        input_layout="TND",
+        actual_seq_qlen=q_cu_seqlens,
+        actual_seq_kvlen=k_cu_seqlens,
+    )[0]
+
+
+@register_op("rotary_interleaved", "npu")
+def rotary_interleaved_npu(inputs: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """Apply the Ascend interleaved rotary kernel to adjacent feature pairs."""
+    return torch_npu.npu_rotary_mul(inputs, cos, sin, rotary_mode="interleave")
