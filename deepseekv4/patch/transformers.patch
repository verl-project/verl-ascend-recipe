+__all__ = [
+    "DeepseekV4PreTrainedModel",
+    "DeepseekV4Model",
+    "DeepseekV4ForCausalLM",
+    "DeepseekV4ForSequenceClassification",
+    "DeepseekV4ForTokenClassification",
+]
