+def get_first_visible_npu_id() -> int | None:
+    """Return the NPU ID of the first card visible to ``npu-smi``, or None if it cannot be determined.
+
+    ``npu-smi info -m`` lists one row per chip as ``NPU ID | Chip ID | Chip Logic ID | Chip Name``.
+    Rows whose ``Chip Logic ID`` is ``-`` are auxiliary chips (e.g. Mcu) and are skipped. Containers
+    that only mount a subset of cards (e.g. ``/dev/davinci4``-``/dev/davinci7``) keep the physical
+    NPU IDs, so the first logical chip's NPU ID is the correct argument for ``npu-smi info -i``.
+    """
+    try:
+        result = subprocess.run(["npu-smi", "info", "-m"], capture_output=True, text=True, check=True)
+    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
+        return None
+    for line in str(result.stdout).splitlines():
+        parts = line.split()
+        if len(parts) < 4 or not parts[0].isdigit() or not parts[1].isdigit():
+            continue
+        if parts[2] == "-":
+            continue
+        return int(parts[0])
+    return None
+
