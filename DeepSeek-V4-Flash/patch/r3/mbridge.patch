+        if split_gate_up:
+            # gate/up split rounds: two rounds per expert (gate, then up);
+            # the product of each round is a complete HF tensor (w1 or w3)
+            # and can be persisted independently.
+            hf_names_all = self._weight_name_mapping_mcore_to_hf(name)
+            for expert_k in range(num_experts_per_rank):
+                block = own_merged[
+                    expert_k * rows_per_expert : (expert_k + 1) * rows_per_expert
+                ]
+                gate, up = block.chunk(2, dim=0)
+                for half_idx, half in enumerate((gate, up)):
+                    gathered = [
+                        torch.empty_like(half) for _ in range(self.mpu.ep_size)
+                    ]
+                    torch.distributed.all_gather(
+                        gathered, half, group=ep_group
