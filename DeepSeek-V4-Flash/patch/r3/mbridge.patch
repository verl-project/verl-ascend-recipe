+    def _weight_to_mcore_format_gemm(
+        self, mcore_weights_name: str, hf_weights: list[torch.Tensor]
+    ) -> torch.Tensor:
+        """
+        Convert Hugging Face weights to the GEMM-format MCore expert tensor.
+
+        Called from :meth:`_weight_to_mcore_format` only for GEMM expert names
+        (see :meth:`_is_expert_gemm_name`). Subclasses using that layout must
+        override this.
+        """
+        raise NotImplementedError(
+            f"GEMM expert layout not supported by {type(self).__name__} "
+            f"for parameter: {mcore_weights_name}"
+        )
+
+    def _export_gemm_weights(
+        self,
+        name: str,
+        broad_pp_param: torch.Tensor,
+        hf_experts_key: str,
+        num_experts_per_rank: int,
+    ) -> Generator[tuple[str, torch.Tensor], None, None]:
+        """
+        Export GEMM-format expert weights (moe_gemm) as per-expert HF weights.
+
+        Only called from :meth:`export_weights` for GEMM expert names with
+        ``ep_size > 1``. The GEMM weight carries the local experts of this EP
+        rank; after merging across ETP (if any) and converting to per-expert HF
+        tensors, the global expert id is spliced back into each HF name using
+        ``hf_experts_key``.
+
+        Streaming cross-EP collection (per-expert-block all_gather): every
+        process first all_gathers within its own ETP group to rebuild the full
+        GEMM weight of its own EP rank, then slices it into
+        ``num_experts_per_rank`` expert blocks and all_gathers each block
+        within its own ``ep_group``. Every member of the group then yields the
+        complete expert sequence, so all ranks produce exactly the same stream
+        of weight names (the base-class symmetry contract relied upon e.g. by
+        verl, where each training rank streams independently to its paired
+        inference engine). Peak memory is ``ep_size`` x one expert block
+        instead of ``ep_size`` full weights, and all collectives reuse the
+        existing ``ep_group`` (no new communication domain, no barrier).
+
+        Args:
+            name: MCore weight name (e.g. ``decoder.layers.0.mlp.experts.weight1``)
+            broad_pp_param: Broadcast GEMM expert tensor (post model-parallel)
+            hf_experts_key: HF path segment locating the expert id, from
+                :meth:`_get_hf_experts_key`
+            num_experts_per_rank: Number of experts owned by each EP rank
+
+        Returns:
+            Generator of ``(hf_name, hf_tensor)`` pairs.
+        """
+        # Stage 1: merge within the own ETP group to rebuild the full GEMM
+        # weight of the EP rank this process belongs to. All processes join
+        # this collective, keeping the group-wide cadence consistent.
+        if self.mpu.etp_size > 1:
+            etp_params = [
+                torch.empty_like(broad_pp_param)
+                for _ in range(self.mpu.etp_size)
+            ]
+            torch.distributed.all_gather(
+                etp_params, broad_pp_param, group=self.mpu.etp_group
+            )
+            own_merged = self._weight_merge_across_tp(
+                name, etp_params, broad_pp_param
+            )
+            # The ETP buffers are merged into own_merged; release them
+            # explicitly so the caching allocator can reuse the memory.
+            del etp_params
+            self._release_gemm_memory(broad_pp_param.device)
+        else:
+            # etp_size == 1: no ETP shard to merge, but the raw GEMM layout
+            # stacks experts along columns (weight1) / row-blocks (weight2),
+            # which differs from the per-expert row-block layout expected by
+            # ``_iter_gemm_export_experts``. ``_weight_merge_across_tp`` with
+            # a single input performs exactly that transposed regrouping, so
+            # the layout of ``own_merged`` matches the etp_size > 1 branch.
+            own_merged = self._weight_merge_across_tp(name, [broad_pp_param], broad_pp_param)
+            self._release_gemm_memory(broad_pp_param.device)
+
+        # Stage 2: stream the experts out, one all_gather per expert block.
+        device = broad_pp_param.device
+        ep_group = self.mpu.ep_group
+        rows_per_expert = own_merged.shape[0] // num_experts_per_rank
+        split_gate_up = (
+            ".weight1" in name and self.mpu.ep_size >= _GEMM_EP_SPLIT_THRESHOLD
+        )
+
+        def splice_name(hf_name: str, global_expert_id: int) -> str:
+            """Replace the local expert id in an HF name with the global id."""
+            hf_name_left, hf_name_right = hf_name.split(hf_experts_key)
+            _, name_suffix = hf_name_right.split(".", 1)
+            return f"{hf_name_left}{hf_experts_key}{global_expert_id}.{name_suffix}"
