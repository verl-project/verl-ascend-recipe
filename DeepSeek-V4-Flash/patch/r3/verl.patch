+def _resolve_num_layer_list(config):
+    """Resolve the per-pipeline-stage layer counts for mindspeed-llm's num_layer_list.
+
+    mindspeed-llm's ``num_layer_list`` feature (e.g. ``num_layer_list='2,4'`` with
+    pp=2) assigns a custom number of layers to each pipeline stage and stores it on
+    the TransformerConfig as ``config.num_layer_list``. The feature only patches
+    ``megatron.core.transformer.transformer_block.get_num_layers_to_build`` and
+    ``TransformerLayer._get_layer_offset`` (used during model build), not the helpers
+    verl re-defines locally in this module, so the list is resolved here to keep
+    verl's layer-count / offset math aligned with the model that was actually built.
+    Falls back to the global megatron args when the config object itself does not
+    carry the attribute (e.g. configs built via mbridge).
+    """
+    num_layer_list = getattr(config, "num_layer_list", None)
+    if isinstance(num_layer_list, str):
+        return [int(x) for x in num_layer_list.split(",") if x.strip() != ""]
+    if num_layer_list:
+        return list(num_layer_list)
+    try:
+        from megatron.training import get_args
+
+        raw = getattr(get_args(), "num_layer_list", None)
+    except Exception:
+        return None
+    if not raw:
+        return None
+    if isinstance(raw, str):
+        return [int(x) for x in raw.split(",") if x.strip() != ""]
+    return list(raw)
+
+
+def _resolve_layer_offset(config, vp_stage=None, pp_rank=None):
+    """Global starting layer index for the current/explicit pipeline stage.
+
+    Honours ``num_layer_list`` (and ``config.layer_offset``) the same way
+    mindspeed-llm does during model build; otherwise delegates to the megatron-core
+    ``get_transformer_layer_offset`` helper, mirroring the original signature
+    inspection so older megatron-core releases keep working.
+    """
+    num_layer_list = _resolve_num_layer_list(config)
+    if num_layer_list:
+        if pp_rank is None:
+            pp_rank = mpu.get_pipeline_model_parallel_rank()
+        layer_offset = getattr(config, "layer_offset", None)
+        if layer_offset is not None:
+            return layer_offset[pp_rank]
+        return sum(num_layer_list[:pp_rank])
+
+    sig = inspect.signature(get_transformer_layer_offset)
+    has_vp_stage = "vp_stage" in sig.parameters
+    has_pp_rank = "pp_rank" in sig.parameters
+    kwargs = {}
+    if has_vp_stage:
+        kwargs["vp_stage"] = vp_stage
+    if has_pp_rank and pp_rank is not None:
+        kwargs["pp_rank"] = pp_rank
+    return get_transformer_layer_offset(config, **kwargs)
+
