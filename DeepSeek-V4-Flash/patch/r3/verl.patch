+def _preprocess_bshd_router_replay(layers_topk_idx):
+    """Mirror ``verl.models.mcore.util.preprocess_bshd_engine`` for routed-experts tensors.
+
+    The bshd engine path (``use_remove_padding=False``) pads every sequence to a
+    2048-aligned ``max_seqlen`` (then to ``lcm(tp, 2*cp)``) and CP-splits it head/tail:
+    rank r takes chunk r and chunk ``2*cp-1-r`` of the *padded* length. The replay
+    targets must follow the exact same layout, otherwise the router's token rows and
+    the replay rows misalign (silently wrong routing when lengths coincide, gather
+    shape errors when they do not).
+
+    Args:
+        layers_topk_idx: Nested (jagged) tensor [bs, seq, layer_num, topk].
+
+    Returns:
+        Tensor [1, bs * local_max_seqlen, layer_num, topk] ready for the TP scatter.
+    """
+    import math
+
+    cp_size = mpu.get_context_parallel_world_size()
+    cp_rank = mpu.get_context_parallel_rank()
+    tp_size = mpu.get_tensor_model_parallel_world_size()
+
+    batch_size = layers_topk_idx.shape[0]
+    seqlens = layers_topk_idx.offsets().diff().tolist()
+    layer_num, topk_num = layers_topk_idx.shape[2], layers_topk_idx.shape[3]
+
+    # Same alignment as preprocess_bshd_engine: 2048 first, then lcm(tp, 2*cp).
+    max_seqlen = max(seqlens)
+    align_value = 2048
+    if max_seqlen % align_value != 0:
+        max_seqlen = ((max_seqlen + align_value - 1) // align_value) * align_value
+    align_size = math.lcm(tp_size, 2 * cp_size) if cp_size > 1 else tp_size
+    if align_size > 1:
+        max_seqlen += (align_size - max_seqlen % align_size) % align_size
+
+    local_max_seqlen = max_seqlen // cp_size if cp_size > 1 else max_seqlen
+
+    # Sentinel expert ids for padded positions (same values as the legacy pad block).
+    pad_values = torch.tensor(
+        [0, 42, 84, 126, 168, 210], dtype=layers_topk_idx.dtype, device=layers_topk_idx.device
+    )
+    if topk_num != pad_values.numel():
+        pad_values = pad_values.repeat(math.ceil(topk_num / pad_values.numel()))[:topk_num]
+    out = (
+        pad_values.view(1, 1, 1, topk_num)
+        .expand(batch_size, local_max_seqlen, layer_num, topk_num)
+        .clone()
+    )
+
+    for i in range(batch_size):
+        if cp_size <= 1:
+            out[i, : seqlens[i]] = layers_topk_idx[i]
+            continue
+        # Same head/tail chunking as preprocess_bshd_engine, on the padded length.
+        seq_padded = (
+            pad_values.view(1, 1, topk_num)
+            .expand(max_seqlen, layer_num, topk_num)
+            .clone()
+        )
+        seq_padded[: seqlens[i]] = layers_topk_idx[i]
+        chunk_len = max_seqlen // (2 * cp_size)
+        first = seq_padded[cp_rank * chunk_len : (cp_rank + 1) * chunk_len]
+        second = seq_padded[(2 * cp_size - 1 - cp_rank) * chunk_len : (2 * cp_size - cp_rank) * chunk_len]
+        out[i] = torch.cat((first, second), dim=0)
+
+    return out.reshape(1, batch_size * local_max_seqlen, layer_num, topk_num)
+
