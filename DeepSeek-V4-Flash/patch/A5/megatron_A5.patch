diff --git a/megatron/core/transformer/transformer_layer.py b/megatron/core/transformer/transformer_layer.py
index 3d62de572..2ef72db24 100644
--- a/megatron/core/transformer/transformer_layer.py
+++ b/megatron/core/transformer/transformer_layer.py
@@ -29,6 +29,47 @@ def get_transformer_layer_offset(config: TransformerConfig):
         if pp_decoder_start is not None:
             pipeline_rank = pipeline_rank - pp_decoder_start
 
+    # MindSpeed-LLM supports an explicit, uneven number of transformer layers
+    # per pipeline stage through ``num_layer_list``.  The model builder already
+    # uses that list to decide how many local layers to construct, so the
+    # global layer-number offset must use the same prefix sum.  Falling through
+    # to Megatron's uniform ``num_layers // pp_size`` calculation creates
+    # duplicate global layer ids and drops the final layers (for example,
+    # 43 layers with PP4 10,11,11,11 becomes 0..9, 10..20, 20..30, 30..40).
+    raw_num_layer_list = getattr(config, "num_layer_list", None)
+    if raw_num_layer_list:
+        if parallel_state.get_virtual_pipeline_model_parallel_world_size() is not None:
+            raise ValueError("num_layer_list does not support virtual pipeline parallelism")
+
+        if isinstance(raw_num_layer_list, str):
+            num_layer_list = [
+                int(value.strip())
+                for value in raw_num_layer_list.strip("'\"").replace(";", ",").split(",")
+                if value.strip()
+            ]
+        else:
+            num_layer_list = [int(value) for value in raw_num_layer_list]
+
+        pp_size = config.pipeline_model_parallel_size
+        if len(num_layer_list) != pp_size:
+            raise ValueError(
+                "num_layer_list length must equal pipeline_model_parallel_size: "
+                f"num_layer_list={num_layer_list}, pp_size={pp_size}"
+            )
+        if any(num_layers < 0 for num_layers in num_layer_list):
+            raise ValueError(f"num_layer_list must contain non-negative values: {num_layer_list}")
+        if sum(num_layer_list) != config.num_layers:
+            raise ValueError(
+                "num_layer_list must sum to config.num_layers: "
+                f"num_layer_list={num_layer_list}, sum={sum(num_layer_list)}, "
+                f"num_layers={config.num_layers}"
+            )
+        if not 0 <= pipeline_rank < pp_size:
+            raise ValueError(f"pipeline rank {pipeline_rank} is outside PP size {pp_size}")
+
+        return sum(num_layer_list[:pipeline_rank])
+
