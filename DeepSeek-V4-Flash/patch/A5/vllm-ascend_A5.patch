+def _create_sleep_persistent_buffer(factory: Callable[[], torch.Tensor]) -> torch.Tensor:
+    """Create an attention control buffer that survives sleep/wake cycles.
+
+    Attention control buffers (e.g. the DSA hadamard matrices) are created
+    outside the weights mem-pool, so CaMem would unmap them on sleep and never
+    remap them (wake only covers the weights/kv_cache tags). Any later access
+    — including the level-2 buffer restore copy — would touch an unmapped VA
+    and fail with aclrtMemcpy errors (507899). Tagging the allocation as
+    sleep-persistent keeps it mapped across sleep/wake. The buffers are tiny
+    control structures, so the extra resident memory is negligible.
+    """
+    try:
+        from vllm_ascend.device_allocator.camem import CaMemAllocator
+
+        allocator = CaMemAllocator.get_instance()
+        with allocator.use_allocation_tag(CaMemAllocator.sleep_persistent_tag):
+            return factory()
+    except Exception:
+        # CaMem unavailable (sleep mode disabled / non-NPU): plain allocation.
+        return factory()
+
+
