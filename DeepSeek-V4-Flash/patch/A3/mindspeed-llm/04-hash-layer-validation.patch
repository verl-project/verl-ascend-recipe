From 08d81b068233c0134ffd3c32de277a6d3cd93fbf Mon Sep 17 00:00:00 2001
From: "chenjiao.angel" <chenjiao.angel@bytedance.com>
Date: Thu, 15 Oct 2026 15:16:07 +0800
Subject: [PATCH] Allow hash layers across small pipeline stages

Downgrade the per-stage hash layer validation error to a warning for supported small model configurations.

Source-commit: ff802915622b02eeb61344d3220d32ad3b82d627
---
 mindspeed_llm/features_manager/moe/moe_router.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/mindspeed_llm/features_manager/moe/moe_router.py b/mindspeed_llm/features_manager/moe/moe_router.py
index dd0af3d0b763137570773f418735ba945751d15b..0f3cbeb298c2152af777613396d993bdcb5f658a 100644
--- a/mindspeed_llm/features_manager/moe/moe_router.py
+++ b/mindspeed_llm/features_manager/moe/moe_router.py
@@ -53,9 +53,13 @@ class MoERouter(MindSpeedFeature):
         if args.n_hash_layers > 0:
             num_layers_per_pp_stage = args.num_layers // args.pipeline_model_parallel_size
             if args.n_hash_layers > num_layers_per_pp_stage:
-                raise ValueError(
-                    f'n_hash_layers ({args.n_hash_layers}) cannot exceed the number of layers in one PP stage '
-                    f'({num_layers_per_pp_stage}).'
+                # verl-ascend-recipe DSV4 4layer test model has num_hash_layers=3 with
+                # pp=2 (2 layers/stage); verified working on 5966485a (e5 runs, kl=0.0008).
+                # This guard was added upstream after the patch baseline (5cce9f57) and is
+                # over-strict for verl usage, so downgrade to a warning.
+                print(
+                    f'WARNING: n_hash_layers ({args.n_hash_layers}) exceeds layers per PP stage '
+                    f'({num_layers_per_pp_stage}); proceeding (upstream guard downgraded).'
                 )
 
             if (
