 import logging
 import os
 from contextlib import contextmanager
@@ -33,6 +34,64 @@ logger = logging.getLogger(__name__)
 MLFLOW_MAX_ATTEMPTS = 3
 MLFLOW_SLEEP_SECONDS = 5
 
+_TRACKING_KEY_MAX_LEN = 64
+_KEY_ABBREV = {
+    "actor_rollout_ref": "arr",
+    "tool_config": "tc",
+    "global_profiler": "gp",
+    "global_tool_config": "gtc",
+    "teacher_models": "tms",
+    "teacher_model": "tm",
+    "engine_kwargs": "ek",
+    "compilation_config": "cc",
+    "checkpoint_engine": "ce",
+    "precision_debugger": "pd",
+    "torch_memory": "tmem",
+    "nsight_options": "nso",
+    "controller_nsight_options": "cnso",
+    "worker_nsight_options": "wnso",
+    "reward_model": "rm",
+    "disaggregation": "disagg",
+}
+def _sanitize_tracking_key(key: str) -> str:
+    original_key = key
+    original_key = key
+    parts = key.split(".")
+    while len(key) > _TRACKING_KEY_MAX_LEN:
+        cands = [(len(p), i) for i, p in enumerate(parts) if p in _KEY_ABBREV]
+        if not cands:
+            break
+        _, idx = max(cands)
+        parts[idx] = _KEY_ABBREV[parts[idx]]
+        key = ".".join(parts)
+    if len(key) > _TRACKING_KEY_MAX_LEN:
+        key = key[: _TRACKING_KEY_MAX_LEN - 7] + "~" + hashlib.md5(original_key.encode()).hexdigest()[:6]
+    return key
+def _flatten_tracking_config(raw: Any, prefix: str = "") -> dict[str, Any]:
+    if isinstance(raw, dict):
+        flattened = {}
+        for key, value in raw.items():
+            child_prefix = f"{prefix}.{key}" if prefix else str(key)
+            flattened.update(_flatten_tracking_config(value, child_prefix))
+        return flattened
+    return {prefix: raw} if prefix else {}
+def _dedupe_tracking_key(key: str, original_key: str, existing: dict[str, Any]) -> str:
+    if key not in existing:
+        return key
+    suffix = "~" + hashlib.md5(original_key.encode()).hexdigest()[:6]
+    return key[: _TRACKING_KEY_MAX_LEN - len(suffix)] + suffix
+def _sanitize_tracking_config(config):
+    """Shorten dotted keys before wandb sends them to Tracking."""
+    if config is None:
+        return {}
+    jsonable_config = _transform_params_to_json_serializable(config, convert_list_to_dict=False)
+    flattened_config = _flatten_tracking_config(jsonable_config)
+    out = {}
+    for k, v in flattened_config.items():
+        key = _sanitize_tracking_key(k)
+        key = _dedupe_tracking_key(key, k, out)
+        out[key] = v
+    return out
 
 class Tracking:
     """A unified tracking interface for logging experiment data to multiple backends.
@@ -81,7 +140,13 @@ class Tracking:
             if config and config["trainer"].get("wandb_proxy", None):
                 settings = wandb.Settings(https_proxy=config["trainer"]["wandb_proxy"])
             entity = os.environ.get("WANDB_ENTITY", None)
-            wandb.init(project=project_name, name=experiment_name, entity=entity, config=config, settings=settings)
+            wandb.init(
