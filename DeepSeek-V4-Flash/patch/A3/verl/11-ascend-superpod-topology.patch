new file mode 100644
--- /dev/null
+++ b/verl/single_controller/ray/ascend_topology.py
@@ -0,0 +1,306 @@
+# Copyright 2026 verl contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+"""Job-scoped Ascend node selection and PG ownership, independent of training roles.
+
+One PG occupies one Ray node. Pools in the same job never share nodes unless they
+explicitly share/split a RayResourcePool. No custom SP resources or env vars are used.
+"""
+
+import logging
+import math
+import time
+import uuid
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+
+import ray
+from ray.util import placement_group_table, remove_placement_group
+from ray.util.placement_group import placement_group
+from ray.util.scheduling_strategies import NodeAffinitySchedulingStrategy
+
+from .ascend_topology_plan import plan_nodes, requests_from_config
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class TopologyPolicy:
+    sp_plan: tuple[tuple[int, int], ...] = ()
+    planning_timeout_s: float = 30
+    allocation_retries: int = 1
+    dcmi_library: str | None = None
+    probe_timeout_s: float = 60
+    placement_timeout_s: float = 1800
+
+    @classmethod
+    def from_config(cls, cfg):
+        if "sp_layout" in cfg:
+            raise ValueError(
+                "trainer.ascend_topology.sp_layout has been removed; remove it for automatic placement, "
+                "or use sp_plan with explicit per-SP node counts"
+            )
+        raw_plan = cfg.get("sp_plan", [])
+        if raw_plan is None:
+            raw_plan = []
+        hint = (
+            'Pass one complete shell argument: "trainer.ascend_topology.sp_plan='
+            '[{sp:2, nodes:8}, {sp:6, nodes:8}]"; do not put quoted strings inside the list.'
+        )
+        if isinstance(raw_plan, (str, bytes)) or not isinstance(raw_plan, Sequence):
+            raise ValueError(f"sp_plan must be a list of mappings; got {type(raw_plan).__name__}: {raw_plan!r}. {hint}")
+        plan = []
+        for index, item in enumerate(raw_plan):
+            if not isinstance(item, Mapping) or set(item.keys()) != {"sp", "nodes"}:
+                raise ValueError(
+                    f"sp_plan[{index}] must be {{sp: integer, nodes: positive integer}}; "
+                    f"got {type(item).__name__}: {item!r}; received sp_plan={raw_plan!r}. {hint}"
+                )
+            sp, count = item["sp"], item["nodes"]
+            if type(sp) is not int or sp < 0 or type(count) is not int or count <= 0:
+                raise ValueError(
+                    f"sp_plan[{index}] requires a non-negative integer SP ID and a positive integer node count; "
+                    f"got sp={sp!r} ({type(sp).__name__}), nodes={count!r} ({type(count).__name__})"
+                )
+            plan.append((sp, count))
+        if len({sp for sp, _ in plan}) != len(plan):
+            raise ValueError("sp_plan must not contain duplicate SP IDs")
+        retries = cfg.get("allocation_retries", 1)
+        if type(retries) is not int or not 0 <= retries <= 10:
+            raise ValueError("allocation_retries must be an integer in [0, 10]")
+        policy = cls(
+            sp_plan=tuple(plan),
+            planning_timeout_s=float(cfg.get("planning_timeout_s", 30)),
+            allocation_retries=retries,
+            dcmi_library=cfg.get("dcmi_library"),
+            probe_timeout_s=float(cfg.get("probe_timeout_s", 60)),
+            placement_timeout_s=float(cfg.get("placement_timeout_s", 1800)),
+        )
+        if any(
+            not math.isfinite(t) or t <= 0
+            for t in (policy.probe_timeout_s, policy.placement_timeout_s, policy.planning_timeout_s)
+        ):
+            raise ValueError("Ascend topology timeouts must be finite and positive")
+        return policy
+
+
+def _query_sp(library_path, timeout_s=60):
+    from verl.utils.ascend_dcmi_probe import query_superpod_id_isolated
+
+    return query_superpod_id_isolated(library_path, timeout_s)
+
+
+def _make_probe_node():
+    @ray.remote(num_cpus=0, max_retries=0)
+    def probe(library_path, timeout_s=60):
+        import warnings
+
+        warnings.filterwarnings(
+            "ignore",
+            message=r"invalid escape sequence",
+            category=SyntaxWarning,
+            module=r"^(?:torch_npu\.op_plugin_docs|.*/torch_npu/op_plugin_docs)(?:\.py)?$",
+        )
+
+        from verl.single_controller.ray.ascend_topology import _query_sp
+
+        try:
+            return _query_sp(library_path, timeout_s)
+        except Exception as exc:
+            node_id = ray.get_runtime_context().get_node_id()
+            raise RuntimeError(f"SP probe failed on Ray node {node_id}: {exc}") from exc
+
+    return probe
+
+
+_probe_node = _make_probe_node()
+
+
+class _TopologyAllocator:
+    """A synchronous Ray actor serializes reservations across trainers/replicas.
+
+    It owns PGs for this Ray job. A reservation is kept until Ray confirms the PG
+    has been removed, even if the available-resource snapshot is temporarily stale.
+    """
+
+    def __init__(self, policy):
+        self.policy = policy
+        self.nodes = {}
+        self.owned = {}  # PG ID -> (PG handle, selected node)
+        self.manifest = None
+        self.pools = {}
+        self.order = {}
+
+    def _check_policy(self, policy):
+        if policy != self.policy:
+            raise ValueError("All Ascend topology pools in one Ray job must use the same policy")
+
+    def _discover(self):
+        alive = [node for node in ray.nodes() if node.get("Alive") and node["Resources"].get("NPU", 0) > 0]
+        missing = [node for node in alive if node["NodeID"] not in self.nodes]
+        refs = [
+            _probe_node.options(
+                scheduling_strategy=NodeAffinitySchedulingStrategy(node_id=node["NodeID"], soft=False)
+            ).remote(self.policy.dcmi_library, self.policy.probe_timeout_s)
+            for node in missing
+        ]
+        if refs:
+            try:
+                # Allow dispatch/result collection and subprocess cleanup beyond
+                # the independently enforced query budget. No new user option.
+                ids = ray.get(refs, timeout=self.policy.probe_timeout_s + 10)
+            except Exception as exc:
+                for ref in refs:
+                    ray.cancel(ref, force=True)
+                raise RuntimeError("DCMI discovery failed/timed out; refusing IP-only fallback") from exc
+            for node, sp in zip(missing, ids, strict=True):
+                node_id, ip = node["NodeID"], node["NodeManagerAddress"]
+                resource = f"node:{ip}"
+                if node["Resources"].get(resource, 0) <= 0:
+                    raise RuntimeError(f"Ray node {node_id} lacks its automatic {resource} resource")
+                self.nodes[node_id] = {"id": node_id, "ip": ip, "sp": sp, "resource": resource}
+            logger.warning("[ascend-topology] discovered %s", [self.nodes[n["NodeID"]] for n in missing])
+        nodes = [self.nodes[node["NodeID"]] for node in alive]
+        if len({node["ip"] for node in nodes}) != len(nodes):
+            raise RuntimeError("Ascend topology requires distinct IPs for distinct Ray nodes")
+        return nodes
+
+    def _verify(self, pgs):
+        for pg in pgs:
+            _, node = self.owned[pg.id.hex()]
+            info = placement_group_table(pg)
+            actual = info.get("bundles_to_node_id", {})
+            if info.get("state") != "CREATED" or len(actual) != pg.bundle_count or set(actual.values()) != {node["id"]}:
+                raise RuntimeError(f"Planned PG {pg.id.hex()} lost its selected node; restart the Ray job")
+
+    def _rollback(self):
+        for pg, _ in self.owned.values():
+            remove_placement_group(pg)
+        deadline = time.monotonic() + min(30, self.policy.placement_timeout_s)
+        while self.owned:
+            for key, (pg, _) in list(self.owned.items()):
+                info = placement_group_table(pg)
+                if not info or info.get("state") == "REMOVED":
+                    del self.owned[key]
+            if self.owned:
+                if time.monotonic() >= deadline:
+                    raise RuntimeError("PG rollback not confirmed; refusing to replan over existing reservations")
+                time.sleep(0.1)
+        self.pools.clear()
+        self.order.clear()
+
+    def prepare(self, policy, requests):
+        self._check_policy(policy)
+        requests = tuple(requests)
+        if self.manifest is not None:
+            if requests != self.manifest:
+                raise ValueError("A Ray job cannot change its topology manifest after reservation")
+            self._verify([pg for pgs in self.pools.values() for pg in pgs])
+            return
+        if self.owned:
+            raise RuntimeError("Previous PG cleanup incomplete; restart the Ray job")
+        for attempt in range(self.policy.allocation_retries + 1):
+            nodes = self._discover()
+            selected = plan_nodes(
+                nodes,
+                ray._private.state.available_resources_per_node(),
+                requests,
+                sp_plan=self.policy.sp_plan,
+                timeout_s=self.policy.planning_timeout_s,
+            )
+            token = uuid.uuid4().hex[:8]
+            try:
+                for request in requests:
+                    pgs = self.pools[request.name] = []
+                    for idx, (bundles, node) in enumerate(zip(request.schemes(), selected[request.name], strict=True)):
+                        bundles[0][node["resource"]] = 0.001
+                        pg = placement_group(bundles, strategy="STRICT_PACK", name=f"{request.name}_{idx}_{token}")
+                        self.order[pg.id.hex()] = len(self.order)
+                        self.owned[pg.id.hex()] = (pg, node)
+                        pgs.append(pg)
+                all_pgs = [pg for pgs in self.pools.values() for pg in pgs]
+                ray.get([pg.ready() for pg in all_pgs], timeout=self.policy.placement_timeout_s)
+                self._verify(all_pgs)
+            except Exception:
+                self._rollback()
+                if attempt == self.policy.allocation_retries:
+                    raise
+                logger.warning("[ascend-topology] reservation raced/failed; replanning before Worker startup")
+                continue
+            self.manifest = requests
+            for request in requests:
+                logger.warning(
+                    "[ascend-topology] pool=%s groups=%s selected=%s",
+                    request.name,
+                    request.groups,
+                    [(idx, node["sp"], node["ip"]) for idx, node in enumerate(selected[request.name])],
+                )
+            return
+
+    def claim(self, policy, name, schemes):
+        self._check_policy(policy)
+        request = next((r for r in self.manifest or () if r.name == name), None)
+        if request is None:
+            raise ValueError(f"Unplanned topology pool {name!r}; prepare the complete task manifest before workers")
+        if schemes != request.schemes():
+            raise ValueError(f"Pool {name!r} resource demand differs from its reserved task plan")
+        pgs = self.pools[name]
+        self._verify(pgs)
+        return pgs
+
+    def sort(self, policy, pgs):
+        self._check_policy(policy)
+        self._verify(pgs)
+        # Preserve the plan's replica/teacher boundaries, including heterogeneous groups.
+        return sorted(pgs, key=lambda pg: self.order[pg.id.hex()])
+
+
+_AllocatorActor = ray.remote(num_cpus=0, max_restarts=0, max_task_retries=0)(_TopologyAllocator)
+
+
+@dataclass
+class AscendTopology:
+    """Small, serializable interface retained by every participating resource pool."""
+
+    allocator: object
+    policy: TopologyPolicy
+    name: str
+
+    def create_placement_groups(self, schemes, pool_name, detached=False):
+        if detached:
+            raise ValueError("Ascend topology PGs are job-scoped; detached pools are not supported")
+        return ray.get(self.allocator.claim.remote(self.policy, pool_name, schemes))
+
+    def sort_placement_groups(self, pgs):
+        return ray.get(self.allocator.sort.remote(self.policy, pgs))
+
+
+def topology_from_config(config):
+    """Return None when disabled, without probing hardware or creating an actor."""
+    cfg = config.get("trainer", {}).get("ascend_topology", {})
+    if not cfg.get("enabled", False):
+        return None
+    policy = TopologyPolicy.from_config(cfg)
+    name = f"verl_ascend_topology_{ray.get_runtime_context().get_job_id()}"
+    allocator = _AllocatorActor.options(name=name, get_if_exists=True, scheduling_strategy="DEFAULT").remote(policy)
+    return AscendTopology(allocator, policy, name)
+
+
+def prepare_topology(config, resource_pool_spec, *, mode="sync"):
+    """Reserve the task's complete plan before constructing its first WorkerGroup."""
+    if not config.get("trainer", {}).get("ascend_topology", {}).get("enabled", False):
+        return None
+    if config["trainer"].get("device", "npu").lower() != "npu":
+        raise ValueError("trainer.ascend_topology requires trainer.device=npu")
+    # Reject invalid mode, replica dimensions, or quota syntax before hardware discovery.
+    requests = requests_from_config(config, resource_pool_spec, mode=mode)
+    topology = topology_from_config(config)
+    logger.warning(
+        "[ascend-topology] mode=%s manifest=%s physical_nodes=%d",
+        mode,
+        [(r.name, r.processes, r.groups) for r in requests],
+        sum(len(r.processes) for r in requests),
+    )
+    ray.get(topology.allocator.prepare.remote(topology.policy, requests))
+    return topology
