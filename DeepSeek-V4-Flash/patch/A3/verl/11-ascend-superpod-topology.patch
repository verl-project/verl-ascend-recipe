+++ b/verl/single_controller/ray/ascend_topology_plan.py
@@ -0,0 +1,413 @@
+# Copyright 2026 verl contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+"""Pure task-wide node planning. No Ray, torch, or hardware side effects."""
+
+import ipaddress
+import logging
+import time
+from collections import Counter, deque
+from dataclasses import dataclass
+from itertools import combinations
+
+logger = logging.getLogger(__name__)
+
+
+def positive_int(value, label):
+    if type(value) is not int or value <= 0:
+        raise ValueError(f"{label} must be a positive integer, got {value!r}")
+    return value
+
+
+@dataclass(frozen=True)
+class PoolRequest:
+    name: str
+    processes: tuple[int, ...]
+    cpus_per_process: int = 3
+    # Consecutive node spans that must each remain in one SP. One means unconstrained.
+    groups: tuple[int, ...] = ()
+
+    def __post_init__(self):
+        if not self.name or not self.processes or len(set(self.processes)) != 1:
+            raise ValueError("Topology pools require a name and homogeneous per-node process counts")
+        for count in self.processes:
+            positive_int(count, self.name)
+        positive_int(self.cpus_per_process, "cpus_per_process")
+        groups = self.groups or (1,) * len(self.processes)
+        for count in groups:
+            positive_int(count, "group size")
+        if sum(groups) != len(self.processes):
+            raise ValueError(f"{self.name}: groups must cover every node exactly once")
+        object.__setattr__(self, "groups", groups)
+
+    def schemes(self):
+        return [[{"NPU": 1, "CPU": self.cpus_per_process} for _ in range(count)] for count in self.processes]
+
+
+def node_key(node):
+    ip = ipaddress.ip_address(node["ip"])
+    return ip.version, int(ip), node["id"]
+
+
+def plan_nodes(nodes, available, requests, sp_plan=(), timeout_s=30):
+    """Return pool -> ordered nodes, satisfying exact quotas and all single-SP spans.
+
+    Whole-node assignments use max flow, so a CPU-rich node is not greedily stolen
+    from a pool that needs it. Backtracking pins multi-node groups to one SP; each
+    branch is pruned by a full resource/quota matching of ALL pools. Automatic
+    placement first finds a feasible plan, then minimizes the number of used SPs
+    and their combined eligible-node capacity, in that order. The latter prefers
+    tighter-fitting blocks and leaves larger untouched blocks available. If the
+    shared planning budget expires during optimization, keep the best feasible
+    plan found; no resource or single-SP constraint is relaxed.
+    """
+    requests = tuple(requests)
+    if not requests or len({r.name for r in requests}) != len(requests):
+        raise ValueError("A task plan must contain uniquely named resource pools")
+    total = sum(len(r.processes) for r in requests)
+    quotas = dict(sp_plan)
+    if sp_plan and sum(quotas.values()) != total:
+        raise ValueError(f"sp_plan total={sum(quotas.values())}, task requires {total} physical Ray nodes")
+    allowed = set(quotas) if sp_plan else {n["sp"] for n in nodes}
+    order = {sp: i for i, sp in enumerate(quotas or sorted(allowed))}
+    nodes = sorted((n for n in nodes if n["sp"] in allowed), key=lambda n: (order[n["sp"]], node_key(n)))
+    if len({n["id"] for n in nodes}) != len(nodes):
+        raise ValueError("Duplicate NodeID in topology snapshot")
+    counts = Counter(n["sp"] for n in nodes)
+    caps = quotas if sp_plan else counts
+    units = []
+    for request in requests:
+        demand = {"NPU": request.processes[0], "CPU": request.processes[0] * request.cpus_per_process}
+        for size in request.groups:
+            eligible = [
+                i
+                for i, node in enumerate(nodes)
+                if available.get(node["id"], {}).get(node["resource"], 0) >= 0.001
+                and all(available.get(node["id"], {}).get(k, 0) >= v for k, v in demand.items())
+            ]
+            units.append((request.name, size, eligible))
+    deadline = time.monotonic() + timeout_s
+
+    def check_time():
+        if time.monotonic() > deadline:
+            raise TimeoutError("Topology planning timed out; no PGs were created. Check SP quotas/replica sizes")
+
+    def match(pinned, active_sps):
+        check_time()
+        # source -> demand groups -> eligible physical nodes -> SP quota -> sink
+        source = 0
+        first_node = 1 + len(units)
+        first_sp = first_node + len(nodes)
+        sp_vertices = {sp: first_sp + i for i, sp in enumerate(order)}
+        sink = first_sp + len(order)
+        graph = [[] for _ in range(sink + 1)]
+
+        def edge(a, b, cap):
+            forward = [b, cap, len(graph[b])]
+            backward = [a, 0, len(graph[a])]
+            graph[a].append(forward)
+            graph[b].append(backward)
+            return forward
+
+        links = []
+        for i, (_, size, eligible) in enumerate(units):
+            edge(source, 1 + i, size)
+            links.append(
+                [
+                    (j, edge(1 + i, first_node + j, 1))
+                    for j in eligible
+                    if nodes[j]["sp"] in active_sps and (i not in pinned or nodes[j]["sp"] == pinned[i])
+                ]
+            )
+        for j, node in enumerate(nodes):
+            edge(first_node + j, sp_vertices[node["sp"]], 1)
+        for sp, vertex in sp_vertices.items():
+            edge(vertex, sink, caps.get(sp, 0))
+        flow = 0
+        while flow < total:
+            check_time()
+            parent = {source: None}
+            queue = deque([source])
+            while queue and sink not in parent:
+                a = queue.popleft()
+                for index, (b, cap, _) in enumerate(graph[a]):
+                    if cap > 0 and b not in parent:
+                        parent[b] = (a, index)
+                        queue.append(b)
+            if sink not in parent:
+                return None
+            b = sink
+            while b != source:
+                a, index = parent[b]
+                e = graph[a][index]
+                e[1] -= 1
+                graph[b][e[2]][1] += 1
+                b = a
+            flow += 1
+        return [[nodes[j] for j, e in group if e[1] == 0] for group in links]
+
+    eligible_counts = [Counter(nodes[j]["sp"] for j in eligible) for _, _, eligible in units]
+
+    def solve(active_sps):
+        check_time()
+        candidates = {
+            i: [sp for sp in order if sp in active_sps and eligible_counts[i][sp] >= size and caps.get(sp, 0) >= size]
+            for i, (_, size, _) in enumerate(units)
+            if size > 1
+        }
+        if any(not options for options in candidates.values()):
+            return None
+        # Harder/larger replica groups first; restore rank ordering at the end.
+        sequence = sorted(candidates, key=lambda i: (len(candidates[i]), -units[i][1], i))
+
+        def search(depth, pinned):
+            assignment = match(pinned, active_sps)
+            if assignment is None:
+                return None
+            if depth == len(sequence):
+                return assignment
+            i = sequence[depth]
+            used = Counter(pinned.values())
+            options = candidates[i]
+            if not sp_plan:
+                options = sorted(options, key=lambda sp: (-used[sp], -eligible_counts[i][sp], sp))
+            for sp in options:
+                pinned[i] = sp
+                result = search(depth + 1, pinned)
+                if result is not None:
+                    return result
+            pinned.pop(i, None)
+            return None
+
+        return search(0, {})
+
+    def compact(best):
+        # Count each currently eligible physical node once, across all pools.
+        # Busy or unusable nodes must not make a block appear larger than it is.
+        free_counts = Counter(nodes[j]["sp"] for j in {j for _, _, eligible in units for j in eligible})
+
+        def score(assignment):
+            used = {node["sp"] for group in assignment for node in group}
+            return len(used), sum(free_counts[sp] for sp in used)
+
+        best_score = score(best)
+        accumulated = 0
+        for minimum_sps, count in enumerate(sorted(free_counts.values(), reverse=True), 1):
+            accumulated += count
+            if accumulated >= total:
+                break
+        if best_score == (minimum_sps, total):
+            return best
+        # SP count dominates fit. Keep iteration lazy and within the SAME budget
+        # as feasibility search; never build an exponential list of subsets.
+        sps = sorted(free_counts, key=lambda sp: (free_counts[sp], sp))
+        try:
+            for size in range(minimum_sps, best_score[0] + 1):
+                # Even the smallest blocks cannot improve this score. This also
+                # avoids enumerating equivalent subsets in homogeneous clusters.
+                if (size, sum(free_counts[sp] for sp in sps[:size])) >= best_score:
+                    break
+                for subset in combinations(sps, size):
+                    check_time()
+                    capacity = sum(free_counts[sp] for sp in subset)
+                    if capacity < total or (size, capacity) >= best_score:
+                        continue
+                    candidate = solve(set(subset))
+                    if candidate is not None:
+                        candidate_score = score(candidate)
+                        if candidate_score < best_score:
+                            best, best_score = candidate, candidate_score
+                        if best_score == (size, total):
+                            return best
+                # All smaller subsets have been checked; only this size's
+                # best fit matters once a feasible assignment has been found.
+                if best_score[0] <= size:
+                    break
+        except TimeoutError:
+            logger.warning(
+                "[ascend-topology] automatic placement optimization reached its time budget; "
+                "using the best feasible plan found (SPs=%s, eligible nodes in selected SPs=%s); "
+                "optimality is not guaranteed",
+                *best_score,
+            )
+        return best
+
+    assignment = solve(set(order))
+    if assignment is None:
+        eligible_counts = {
+            request.name: dict(Counter(nodes[j]["sp"] for j in next(u[2] for u in units if u[0] == request.name)))
+            for request in requests
+        }
+        raise RuntimeError(
+            f"No feasible single-SP replica plan: free eligible nodes by pool/SP={eligible_counts}; "
+            f"required groups={[(r.name, r.groups) for r in requests]}; sp_plan={list(sp_plan)}. "
+            "Total free nodes alone is insufficient; check CPU/NPU capacity and complete replica slots."
+        )
+    if not sp_plan:
+        assignment = compact(assignment)
+    result = {r.name: [] for r in requests}
+    for (name, _, _), selected in zip(units, assignment, strict=True):
+        result[name].extend(sorted(selected, key=node_key))
+    # Equal-size groups contribute a multiple of that size to every SP, so a
+    # full SP/IP sort preserves replica boundaries. Heterogeneous teacher spans
+    # must retain their original group positions.
+    for request in requests:
+        if len(set(request.groups)) == 1:
+            result[request.name].sort(key=lambda n: (order[n["sp"]], node_key(n)))
+    return result
+
+
+def replica_world_size(rollout):
+    if rollout.get("name", "vllm") not in ("vllm", "sglang"):
+        raise ValueError("Ascend topology planning currently supports vllm/sglang replicas")
+    if (rollout.get("disaggregation") or {}).get("enabled", False):
+        raise ValueError("This VERL version's PD backends reject NPU execution; disable PD for Ascend topology")
+    world = 1
+    for field in ("tensor_model_parallel_size", "data_parallel_size", "pipeline_model_parallel_size"):
+        world *= positive_int(rollout.get(field, 1), field)
+    return world
+
+
+def replica_spans(world, replica_world):
+    if world <= 0 or world % replica_world:
+        raise ValueError(f"Pool world_size={world} must be a positive multiple of replica world_size={replica_world}")
+    return [(start, start + replica_world) for start in range(0, world, replica_world)]
+
+
+def replica_world_on_nodes(rollout, per_node):
+    """Match RolloutReplica's node layout before reserving any resources."""
+    world = replica_world_size(rollout)
+    per_node = positive_int(per_node, "n_gpus_per_node")
+    if world % min(per_node, world):
+        raise ValueError(f"Replica world_size={world} must be divisible by per-node processes={min(per_node, world)}")
+    return world
+
+
+def pool_request(name, processes, spans=(), cpus=3):
+    processes = tuple(processes)
+    if not processes or len(set(processes)) != 1:
+        raise ValueError(f"{name}: expected homogeneous nonempty pool")
+    per_node = positive_int(processes[0], "processes per node")
+    joins = set()
+    for start, end in spans:
+        if start < 0 or end <= start or end > sum(processes):
+            raise ValueError(f"{name}: invalid replica rank span {(start, end)}")
+        first, last = start // per_node, (end - 1) // per_node
+        # Match the existing replica implementation's node alignment requirements.
+        if last - first + 1 != (end - start + per_node - 1) // per_node:
+            raise ValueError(f"{name}: replica rank span {(start, end)} is not node aligned")
+        joins.update(range(first, last))
+    groups, size = [], 1
+    for index in range(len(processes) - 1):
+        if index in joins:
+            size += 1
+        else:
+            groups.append(size)
+            size = 1
+    groups.append(size)
+    return PoolRequest(name, processes, cpus, tuple(groups))
+
+
+def standalone_requests(rollout, nnodes, per_node, prefix="rollout_pool_", start_rank=0):
+    world = replica_world_on_nodes(rollout, per_node)
+    per_node = positive_int(per_node, "n_gpus_per_node")
+    total = positive_int(nnodes, "nnodes") * per_node
+    spans = replica_spans(total, world)
+    per_replica_node = min(per_node, world)
+    count = world // per_replica_node
+    return [
+        PoolRequest(f"{prefix}{start_rank + i}", (per_replica_node,) * count, 2, (count,)) for i in range(len(spans))
+    ]
+
+
+def teacher_spans(config):
+    teachers = dict(config.get("teacher_models", {}))
+    per_node = positive_int(config.get("n_gpus_per_node"), "distillation.n_gpus_per_node")
+    total = positive_int(config.get("nnodes"), "distillation.nnodes") * per_node
+    if len(teachers) == 1 and "teacher_model" in teachers:
+        return replica_spans(total, replica_world_on_nodes(teachers["teacher_model"]["inference"], per_node))
+    teachers.pop("teacher_model", None)
+    spans, offset = [], 0
+    for teacher in teachers.values():
+        world = replica_world_on_nodes(teacher["inference"], per_node)
+        for _ in range(positive_int(teacher.get("num_replicas"), "teacher.num_replicas")):
+            spans.append((offset, offset + world))
+            offset += world
+    if offset != total:
+        raise ValueError("Teacher replica sizes do not cover the configured teacher pool")
+    return spans
+
+
+def requests_from_config(config, resource_pool_spec, *, mode="sync"):
+    """Build the complete manifest before ANY training PG is allocated.
+
+    V0/sync/colocate_async reuse the training pool for rollout. V1 separate_async
+    also starts standalone replicas. Fully async has separate training and rollout
+    pools, and optionally hybrid replicas on training nodes. The entrypoint passes
+    its actual mode explicitly; the presence of async config keys is not a selector.
+    Later callers only claim reservations; they cannot add an unplanned pool.
+    """
+    if mode not in ("v0", "sync", "colocate_async", "separate_async", "fully_async"):
+        raise ValueError(f"Unsupported Ascend topology trainer mode: {mode!r}")
+    specs = {name: tuple(counts) for name, counts in resource_pool_spec.items()}
+    rollout = config["actor_rollout_ref"]["rollout"]
+    trainer = config["trainer"]
+    per_node = positive_int(trainer["n_gpus_per_node"], "trainer.n_gpus_per_node")
+    fully_async = mode == "fully_async"
+    shared_name = "trainer_pool" if fully_async else "global_pool"
+    if shared_name not in specs or specs[shared_name] != (per_node,) * positive_int(
+        trainer["nnodes"], "trainer.nnodes"
+    ):
+        raise ValueError(f"{mode} requires a {shared_name} matching trainer.nnodes/n_gpus_per_node")
+    async_cfg = config.get("async_training", {})
+    dynamic = async_cfg.get("use_dynamic_resource_scheduling", False)
+    hybrid = not fully_async or dynamic or async_cfg.get("use_trainer_do_validate", False)
+    constraints = {name: [] for name in specs}
+    start_rank = 0
+    if hybrid:
+        world = sum(specs[shared_name])
+        if rollout.get("n_gpus_per_node", per_node) != per_node:
+            raise ValueError("Hybrid rollout and trainer must use the same n_gpus_per_node")
+        constraints[shared_name] += replica_spans(world, replica_world_on_nodes(rollout, per_node))
+        start_rank = len(constraints[shared_name])
+    extra = []
+    if fully_async or mode == "separate_async":
+        standalone = config["rollout"] if fully_async else rollout
+        nnodes = standalone["nnodes"]
+        if type(nnodes) is not int or nnodes < 0:
+            raise ValueError(f"Standalone rollout.nnodes must be a non-negative integer, got {nnodes!r}")
+        if fully_async and any(rollout.get(key) != standalone[key] for key in ("nnodes", "n_gpus_per_node")):
+            raise ValueError("Fully async must copy top-level rollout dimensions before preparing topology")
+        if nnodes == 0:
+            if not (fully_async and dynamic):
+                raise ValueError(
+                    "Zero standalone rollout nodes require fully_async with use_dynamic_resource_scheduling=true"
+                )
+        else:
+            extra += standalone_requests(rollout, nnodes, standalone["n_gpus_per_node"], start_rank=start_rank)
+    reward = config.get("reward", {}).get("reward_model", {})
+    if not reward.get("enable", False):
+        specs.pop("reward_pool", None)
+    if reward.get("enable", False):
+        if (fully_async or mode == "separate_async") and not reward.get("enable_resource_pool", False):
+            raise ValueError(f"{mode} requires reward.reward_model.enable_resource_pool=true when RM is enabled")
+        if fully_async:
+            extra += standalone_requests(
+                reward["rollout"], reward["nnodes"], reward["n_gpus_per_node"], prefix="rollout_pool_reward_"
+            )
+        else:
+            name = "reward_pool" if reward.get("enable_resource_pool", False) else "global_pool"
+            if name not in specs:
+                raise ValueError(f"Enabled reward model requires resource pool {name!r}")
+            if reward["n_gpus_per_node"] != specs[name][0]:
+                raise ValueError("Reward model n_gpus_per_node must match its resource pool")
+            constraints[name] += replica_spans(
+                sum(specs[name]), replica_world_on_nodes(reward["rollout"], reward["n_gpus_per_node"])
+            )
+    distillation = config.get("distillation", {})
+    if distillation.get("enabled", False):
+        if "teacher_pool" not in specs:
+            specs["teacher_pool"] = (distillation["n_gpus_per_node"],) * distillation["nnodes"]
+        constraints["teacher_pool"] = teacher_spans(distillation)
+    return tuple(pool_request(name, counts, constraints.get(name, ())) for name, counts in specs.items()) + tuple(extra)
