--- /dev/null
+++ b/verl/utils/ascend_dcmi.py
@@ -0,0 +1,94 @@
+# Copyright 2026 verl contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+"""Read physical SuperPod identity without importing torch or initializing an NPU context."""
+
+import ctypes
+
+
+class _SpodInfo(ctypes.Structure):
+    # dcmi_interface_api.h: struct dcmi_spod_info (48 bytes).
+    _fields_ = [
+        ("sdid", ctypes.c_uint),
+        ("super_pod_size", ctypes.c_uint),
+        ("super_pod_id", ctypes.c_uint),
+        ("server_index", ctypes.c_uint),
+        ("reserve", ctypes.c_uint * 8),
+    ]
+
+
+def _load_library(path):
+    candidates = (
+        [path]
+        if path
+        else [
+            "libdcmi.so",
+            "/usr/local/dcmi/libdcmi.so",
+            "/usr/local/Ascend/driver/lib64/common/libdcmi.so",
+        ]
+    )
+    errors = []
+    for candidate in candidates:
+        try:
+            return ctypes.CDLL(candidate)
+        except OSError as exc:
+            errors.append(f"{candidate}: {exc}")
+    raise RuntimeError("Cannot load DCMI: " + "; ".join(errors))
+
+
+def _check(ret, operation):
+    if ret != 0:
+        raise RuntimeError(f"DCMI {operation} failed: ret={ret}; check driver, device mounts and permissions")
+
+
+def query_superpod_id(library_path=None, *, _on_stage=None):
+    """Return the single physical SP ID of all locally visible NPU chips.
+
+    Uses DCMI_MAIN_CMD_CHIP_INF=12 / DCMI_CHIP_INF_SUB_CMD_SPOD_INFO=1.
+    Query failure is fatal; it must never silently become an IP-only allocation.
+    """
+    stage = _on_stage or (lambda operation: None)
+    stage("load libdcmi")
+    lib = _load_library(library_path)
+    int_ptr = ctypes.POINTER(ctypes.c_int)
+    uint_ptr = ctypes.POINTER(ctypes.c_uint)
+    signatures = {
+        "dcmi_init": [],
+        "dcmi_get_card_list": [int_ptr, int_ptr, ctypes.c_int],
+        "dcmi_get_device_num_in_card": [ctypes.c_int, int_ptr],
+        "dcmi_get_device_info": [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_void_p, uint_ptr],
+    }
+    for name, argtypes in signatures.items():
+        function = getattr(lib, name)
+        function.argtypes = argtypes
+        function.restype = ctypes.c_int
+    stage("dcmi_init")
+    _check(lib.dcmi_init(), "init")
+    cards = (ctypes.c_int * 64)()
+    count = ctypes.c_int()
+    stage("dcmi_get_card_list")
+    _check(lib.dcmi_get_card_list(ctypes.byref(count), cards, len(cards)), "get_card_list")
+    if not 0 < count.value <= len(cards):
+        raise RuntimeError(f"Invalid visible DCMI card count: {count.value}")
+    ids = set()
+    for card in cards[: count.value]:
+        devices = ctypes.c_int()
+        stage(f"dcmi_get_device_num_in_card(card={card})")
+        _check(lib.dcmi_get_device_num_in_card(card, ctypes.byref(devices)), f"device_count(card={card})")
+        if not 0 < devices.value <= 64:
+            raise RuntimeError(f"Invalid DCMI device count on card {card}: {devices.value}")
+        for device in range(devices.value):
+            info = _SpodInfo()
+            size = ctypes.c_uint(ctypes.sizeof(info))
+            stage(f"dcmi_get_device_info(card={card}, device={device})")
+            _check(
+                lib.dcmi_get_device_info(card, device, 12, 1, ctypes.byref(info), ctypes.byref(size)),
+                f"spod_info(card={card}, device={device})",
+            )
+            if size.value != ctypes.sizeof(info) or info.super_pod_id == 0xFFFFFFFF:
+                raise RuntimeError(f"Invalid DCMI spod_info on card={card}, device={device}")
+            ids.add(info.super_pod_id)
+    if len(ids) != 1:
+        raise RuntimeError(f"One Ray node must belong to one physical SuperPod; DCMI returned {sorted(ids)}")
+    return ids.pop()
diff --git a/verl/utils/ascend_dcmi_probe.py b/verl/utils/ascend_dcmi_probe.py
new file mode 100644
--- /dev/null
+++ b/verl/utils/ascend_dcmi_probe.py
@@ -0,0 +1,204 @@
+# Copyright 2026 verl contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+"""Isolate DCMI from Ray/Torch and supervise its lifetime without query threads.
+
+Ray worker -> relay -> supervisor -> single-threaded DCMI interpreter.
+The relay absorbs Ray's forced direct-child cleanup; its surviving supervisor
+observes the relay's exit and kills the query group. All helper interpreters
+run this file by absolute path with -I -S, bypassing package
+imports, PYTHONPATH, sitecustomize and .pth hooks. The supervisor remains outside
+the process that calls DCMI; it also cleans up if the Ray caller is killed.
+"""
+
+import json
+import math
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+
+def _command(*arguments):
+    return [sys.executable, "-I", "-S", str(Path(__file__).resolve()), *arguments]
+
+
+def _stop_supervisor(process):
+    # SIGTERM lets the supervisor clean its separate query process group first.
+    if process.poll() is None:
+        process.terminate()
+    try:
+        process.communicate(timeout=3)
+    except subprocess.TimeoutExpired:
+        process.kill()
+        process.communicate()
+
+
+def query_superpod_id_isolated(library_path=None, timeout_s=60):
+    """Run one local query; never load libdcmi in this calling process."""
+    timeout_s = float(timeout_s)
+    if not math.isfinite(timeout_s) or timeout_s <= 0:
+        raise ValueError("DCMI query timeout must be finite and positive")
+    process = subprocess.Popen(
+        _command("--relay", str(os.getpid()), str(timeout_s), library_path or ""),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+    try:
+        stdout, stderr = process.communicate(timeout=timeout_s + 5)
+    except subprocess.TimeoutExpired as exc:
+        _stop_supervisor(process)
+        raise RuntimeError("DCMI supervisor did not finish within its query/cleanup deadline") from exc
+    except BaseException:
+        _stop_supervisor(process)
+        raise
+    try:
+        result = json.loads(stdout)
+    except (ValueError, TypeError) as exc:
+        raise RuntimeError(f"DCMI supervisor exited {process.returncode} without a result: {stderr[-2000:]}") from exc
+    if process.returncode != 0 or not isinstance(result, dict) or not result.get("ok"):
+        detail = result.get("error", result) if isinstance(result, dict) else result
+        raise RuntimeError(f"Isolated SP query failed: {detail}")
+    sp = result.get("sp")
+    if type(sp) is not int or not 0 <= sp < 0xFFFFFFFF:
+        raise RuntimeError(f"DCMI supervisor returned an invalid SP ID: {sp!r}")
+    return sp
+
+
+def _kill_query(process):
+    # start_new_session gives this invocation its own group. DCMI's forked
+    # children inherit it; kill the group even if its leader already exited.
+    try:
+        os.killpg(process.pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+    process.wait(timeout=2)
+
+
+def _relay(owner_pid, timeout_s, library_path):
+    """Shield the cleanup supervisor from Ray's direct-child SIGKILL policy."""
+    cancelled = []
+
+    def cancel(signum, frame):
+        cancelled.append(signum)
+
+    signal.signal(signal.SIGTERM, cancel)
+    signal.signal(signal.SIGINT, cancel)
+    if os.getppid() != owner_pid:
+        return 1
+    process = subprocess.Popen(_command("--supervise", str(os.getpid()), str(timeout_s), library_path))
+    deadline = time.monotonic() + timeout_s + 3
+    try:
+        while process.poll() is None:
+            if cancelled or os.getppid() != owner_pid or time.monotonic() >= deadline:
+                break
+            time.sleep(0.05)
+    finally:
+        _stop_supervisor(process)
+    return process.returncode
+
+
+def _tail(file, limit=4096):
+    file.seek(0, os.SEEK_END)
+    file.seek(max(0, file.tell() - limit))
+    return file.read().decode("utf-8", errors="replace")
+
+
+def _supervise(owner_pid, timeout_s, library_path):
+    cancelled = []
+
+    def cancel(signum, frame):
+        cancelled.append(signum)
+
+    signal.signal(signal.SIGTERM, cancel)
+    signal.signal(signal.SIGINT, cancel)
+    if os.getppid() != owner_pid:
+        return {"ok": False, "error": "Ray caller exited before DCMI query startup"}
+    with tempfile.TemporaryFile() as events, tempfile.TemporaryFile() as output:
+        deadline = time.monotonic() + timeout_s
+        process = subprocess.Popen(
+            _command("--query", str(events.fileno()), library_path),
+            pass_fds=(events.fileno(),),
+            stdout=output,
+            stderr=output,
+            start_new_session=True,
+        )
+        reason = None
+        try:
+            while process.poll() is None:
+                if cancelled or os.getppid() != owner_pid:
+                    reason = "Ray caller exited or cancelled the query"
+                    break
+                if time.monotonic() >= deadline:
+                    reason = f"query timed out after {timeout_s:g}s"
+                    break
+                time.sleep(min(0.05, max(0, deadline - time.monotonic())))
+        finally:
+            _kill_query(process)
+        stage = "query interpreter startup"
+        result = None
+        # A separate inherited descriptor keeps native stdout/stderr away from
+        # the result protocol. Read only after the entire query group is stopped.
+        for line in _tail(events, 65536).splitlines():
+            try:
+                event = json.loads(line)
+            except ValueError:
+                continue
+            if "stage" in event:
+                stage = event["stage"]
+            if "ok" in event:
+                result = event
+        if reason is None and process.returncode == 0 and result and result.get("ok"):
+            return result
+        if reason is None:
+            reason = result.get("error") if result else None
+            reason = reason or f"query interpreter exit code {process.returncode}"
+        return {
+            "ok": False,
+            "error": f"{reason}; last stage={stage}; output tail={_tail(output)!r}",
+        }
+
+
+def _query(event_fd, library_path):
+    # Do not import verl, Ray or Torch here, or start a watchdog thread.
+    import runpy
+
+    with os.fdopen(event_fd, "w", buffering=1) as events:
+
+        def emit(record):
+            events.write(json.dumps(record, ensure_ascii=True) + "\n")
+            events.flush()
+
+        try:
+            emit({"stage": "load standalone DCMI code"})
+            namespace = runpy.run_path(str(Path(__file__).with_name("ascend_dcmi.py")))
+            sp = namespace["query_superpod_id"](library_path or None, _on_stage=lambda stage: emit({"stage": stage}))
+            emit({"ok": True, "sp": sp})
+            return 0
+        except Exception as exc:  # noqa: BLE001 - serialize failures across the process boundary
+            emit({"ok": False, "error": f"{type(exc).__name__}: {exc}"})
+            return 1
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 4 and sys.argv[1] == "--query":
+        sys.exit(_query(int(sys.argv[2]), sys.argv[3]))
+    if len(sys.argv) == 5 and sys.argv[1] == "--relay":
+        sys.exit(_relay(int(sys.argv[2]), float(sys.argv[3]), sys.argv[4]))
+    if len(sys.argv) == 5 and sys.argv[1] == "--supervise":
+        try:
+            result = _supervise(int(sys.argv[2]), float(sys.argv[3]), sys.argv[4])
+        except Exception as exc:  # noqa: BLE001 - final process-boundary error response
+            result = {
+                "ok": False,
+                "error": f"DCMI supervisor error: {type(exc).__name__}: {exc}",
+            }
+        print(json.dumps(result, ensure_ascii=True), flush=True)
+        sys.exit(0 if result.get("ok") else 1)
+    raise SystemExit("Internal DCMI helper: expected --relay, --supervise or --query")
