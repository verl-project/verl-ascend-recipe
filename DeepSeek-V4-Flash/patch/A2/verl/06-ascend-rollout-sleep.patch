+
+"""Synchronize Ascend work before sleep releases device memory mappings."""
+
+from functools import wraps
+
+
+def patch_ascend_allocator_sleep():
+    import torch
+    from vllm_ascend.device_allocator.camem import CaMemAllocator
+
+    original_sleep = CaMemAllocator.sleep
+    if getattr(original_sleep, "_verl_synchronize_before_sleep", False):
+        return
+
+    @wraps(original_sleep)
+    def synchronized_sleep(self, *args, **kwargs):
+        # CaMemAllocator unmaps weights/KV memory before empty_cache() performs
+        # its synchronization. Queued graph kernels can still use those mappings.
+        # Wait for all streams before the first unmap, including level 2 sleep
+        # which has no synchronous weight copies to the host.
+        torch.npu.synchronize()
+        return original_sleep(self, *args, **kwargs)
+
+    synchronized_sleep._verl_synchronize_before_sleep = True
+    CaMemAllocator.sleep = synchronized_sleep
\ No newline at end of file
