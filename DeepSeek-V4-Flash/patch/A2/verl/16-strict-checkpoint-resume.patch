+def _strict_ckpt_resume() -> bool:
+    """dsv4-ckpt-29: missing dataloader or TransferQueue state fails the resume.
+
+    Set VERL_STRICT_CKPT_RESUME=0 to keep the old warn-and-continue behavior.
+    """
+    return os.environ.get("VERL_STRICT_CKPT_RESUME", "1").lower() not in ("0", "false", "no")
+
