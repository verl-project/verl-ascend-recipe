+def _atomic_torch_save(obj, path: str) -> None:
+    tmp = path + ".tmp"
+    torch.save(obj, tmp)
+    os.replace(tmp, path)
+
+
+def _atomic_write_text(path: str, text: str) -> None:
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        f.write(text)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
+
+
+def _atomic_write_json(path: str, payload: dict) -> None:
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(payload, f, indent=2, sort_keys=True)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
+
+
+def _checkpoint_publish_state(folder: str, *, require_tq: bool) -> str:
+    """dsv4-ckpt-29: 'complete', 'legacy', or 'partial'.
+
+    A new save is complete only after ``ckpt_complete.json`` is replaced into
+    place. Older saves have no marker; they count as legacy when the actor
+    manifest, ``data.pt``, and (for async trainers) ``transfer_queue/`` are
+    all present. Anything else is a partial save and must not be resumed.
+    """
+    if os.path.isfile(os.path.join(folder, "ckpt_complete.json")):
+        return "complete"
+    actor_ok = os.path.isfile(os.path.join(folder, "actor", "ckpt_contents.json"))
+    data_ok = os.path.isfile(os.path.join(folder, "data.pt"))
+    tq_ok = os.path.isdir(os.path.join(folder, "transfer_queue"))
+    if actor_ok and data_ok and (tq_ok or not require_tq):
+        return "legacy"
+    return "partial"
+
+
+def _iter_global_step_dirs(root: str):
+    if not root or not os.path.isdir(root):
+        return
+    for name in os.listdir(root):
+        if not name.startswith("global_step_"):
+            continue
+        folder = os.path.join(root, name)
+        suffix = name[len("global_step_") :]
+        if suffix.isdigit() and os.path.isdir(folder):
+            yield int(suffix), folder
+
+
+def _previous_complete_checkpoint(root: str, *, require_tq: bool, exclude: str | None) -> str | None:
+    exclude_abs = os.path.abspath(exclude) if exclude else None
+    found = None
+    for _step, folder in sorted(_iter_global_step_dirs(root)):
+        if exclude_abs and os.path.abspath(folder) == exclude_abs:
+            continue
+        if _checkpoint_publish_state(folder, require_tq=require_tq) != "partial":
+            found = folder
+    return found
+
+
+def _retain_published_checkpoints(root: str, keep: int | None, protect: list[str]) -> None:
+    """Delete whole step directories only after a new step has been published."""
+    if not isinstance(keep, int) or keep <= 0 or not root or not os.path.isdir(root):
+        return
+    steps = sorted(_iter_global_step_dirs(root))
+    protect_abs = {os.path.abspath(path) for path in protect if path}
+    keep_abs = {os.path.abspath(path) for _step, path in steps[-keep:]} | protect_abs
+    for _step, folder in steps:
+        if os.path.abspath(folder) in keep_abs:
+            continue
+        logger.info("[CKPT-PUBLISH] removing checkpoint over retention cap: %s", folder)
+        shutil.rmtree(folder, ignore_errors=True)
+
+
+
+def _invalidate_unpublished_checkpoint(folder: str) -> None:
+    """dsv4-ckpt-39: this step must not look complete or legacy until publish.
+
+    Drops the trainer marker, the actor manifest, and ``data.pt``. Other
+    ``global_step_*`` directories stay, and this does not run retention.
+    """
+    if not folder:
+        return
+    for path in (
+        os.path.join(folder, "ckpt_complete.json"),
+        os.path.join(folder, "actor", "ckpt_contents.json"),
+        os.path.join(folder, "data.pt"),
+    ):
+        try:
+            os.remove(path)
+        except FileNotFoundError:
+            continue
+        except OSError as exc:
+            logger.warning("[CKPT-PUBLISH] could not invalidate %s: %s", path, exc)
+
