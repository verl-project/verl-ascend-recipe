+    def _fold_layer_axis_into_key(model_sharded_state_dict):
+        """Fold the prepended pipeline layer axis into every tensor key.
+
+        In a homogeneous transformer block the layer index is carried only by the
+        prepended axis, so all layers emit the same key. That breaks once layers
+        are heterogeneous (DSV4 uses per-layer compression ratios and only some
+        layers own ``tid2eid``): different layers then disagree on the shape
+        stored under a single key. Moving the layer index into the key leaves the
+        remaining TP/EP fragmentations untouched.
+        """
+        for sharded in nested_values(model_sharded_state_dict):
+            if not isinstance(sharded, ShardedTensor) or sharded.prepend_axis_num != 1:
+                continue
+            if "layers." not in sharded.key:
+                continue
+            layer_offset = sharded.global_offset[0]
+            sharded.key = sharded.key.replace("layers.", f"layers.{layer_offset}.", 1)
+            sharded.global_shape = sharded.global_shape[1:]
+            sharded.global_offset = sharded.global_offset[1:]
+            sharded.axis_fragmentations = sharded.axis_fragmentations[1:]
+            sharded.prepend_axis_num = 0
