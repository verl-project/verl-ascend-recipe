+        for sharded in nested_values(model_sharded_state_dict):
+            if not isinstance(sharded, ShardedTensor) or not sharded.key.endswith(".tid2eid"):
+                continue
+            if sharded.prepend_axis_num and "layers." in sharded.key:
+                layer_offset = sharded.global_offset[0]
+                sharded.key = sharded.key.replace("layers.", f"layers.{layer_offset}.", 1)
+            local_shape = tuple(sharded.local_shape)
+            sharded.global_shape = local_shape
+            sharded.global_offset = (0,) * len(local_shape)
+            sharded.axis_fragmentations = (1,) * len(local_shape)
+            sharded.prepend_axis_num = 0
