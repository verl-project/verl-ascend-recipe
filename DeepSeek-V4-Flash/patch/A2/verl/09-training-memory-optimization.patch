@@ -177,8 +177,25 @@ class MindSpeedMegatronEngineWithLMHead(MegatronEngineWithLMHead):
         if self.enable_routing_replay:
             print(f"routing replay layers: {len(RouterReplay.router_instances)}")
 
+        from megatron.training import get_args
+
+        from .deepseek4_memory import configure_rope_cache, install_checkpoint_input_tracking
+
+        args = get_args()
+        configure_rope_cache(module, args.seq_length)
+        install_checkpoint_input_tracking()
         return module
 
+    def forward_backward_batch(self, data, loss_function, forward_only=False):
+        from verl.utils.device import get_torch_device
+
+        from .deepseek4_memory import release_completed_checkpoint_inputs
+
+        if forward_only or self.model_config.mtp.enable:
+            return super().forward_backward_batch(data, loss_function, forward_only=forward_only)
+        with release_completed_checkpoint_inputs(self.module, get_torch_device()):
+            return super().forward_backward_batch(data, loss_function, forward_only=forward_only)
+
     def to(self, device: str, model: bool = True, optimizer: bool = True, grad: bool = True):
         """
         Move model parameters, optimizer states, or both to the specified device.
@@ -191,3 +208,10 @@ class MindSpeedMegatronEngineWithLMHead(MegatronEngineWithLMHead):
         """
         reset_fp8_reuse_quantized_weight(self, device, model, optimizer, grad)
         super().to(device=device, model=model, optimizer=optimizer, grad=grad)
+        if device == "cpu" and model:
+            from verl.utils.device import get_torch_device
+
+            from .deepseek4_memory import clear_rope_cache
+
+            clear_rope_cache(self.module)
+            get_torch_device().empty_cache()
