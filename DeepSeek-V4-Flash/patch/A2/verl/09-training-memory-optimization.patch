+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import functools
+import sys
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+import torch
+from torch.multiprocessing.reductions import StorageWeakRef
+
+_CHECKPOINT_INPUTS = ContextVar("deepseek4_checkpoint_inputs", default=None)
+_CHECKPOINT_HOOKS = ContextVar("deepseek4_checkpoint_hooks", default=None)
+
+
+def track_checkpoint_tensor(tensor, tracked, hooks):
+    """Observe input and input-gradient storage without holding either allocation alive."""
+    tracked.append(StorageWeakRef(tensor.untyped_storage()))
+
+    def capture_gradient(gradient):
+        tracked.append(StorageWeakRef(gradient.untyped_storage()))
+
+    hooks.append(tensor.register_hook(capture_gradient))
+
+
+def install_checkpoint_input_tracking():
+    """Track MHC checkpoint inputs without retaining their tensor objects."""
+    from megatron.core.tensor_parallel.random import CheckpointFunction
+
+    original = CheckpointFunction.forward
+    if getattr(original, "_verl_tracks_mhc_inputs", False):
+        return
+
+    @functools.wraps(original)
+    def forward(ctx, run_function, distribute_saved_activations, *args):
+        tracked = _CHECKPOINT_INPUTS.get()
+        if tracked is not None:
+            for value in args:
+                if (
+                    isinstance(value, torch.Tensor)
+                    and value.device.type != "cpu"
+                    and value.ndim == 4
+                    and value.dtype == torch.bfloat16
+                    and value.requires_grad
+                ):
+                    # Saved/detached tensor wrappers may die while another
+                    # wrapper still owns the same allocation. Track StorageImpl
+                    # weakly so those aliases remain visible without extending
+                    # the allocation's lifetime through the pipeline schedule.
+                    track_checkpoint_tensor(value, tracked, _CHECKPOINT_HOOKS.get())
+        return original(ctx, run_function, distribute_saved_activations, *args)
+
+    forward._verl_tracks_mhc_inputs = True
+    CheckpointFunction.forward = staticmethod(forward)
+
+
+@contextmanager
+def release_completed_checkpoint_inputs(models, device):
+    """Release tracked MHC activation storage only after the entire backward finishes.
+
+    The checkpoint implementation can retain saved inputs through graph objects
+    after backward. Their storage is no longer read once the complete pipeline
+    schedule returns. This boundary avoids freeing inputs shared by other layers
+    while their backward is still running. Parameter and gradient storage is
+    excluded, and failed schedules do not release any tracked inputs.
+    """
+    tracked = []
+    hooks = []
+    token = _CHECKPOINT_INPUTS.set(tracked)
+    hook_token = _CHECKPOINT_HOOKS.set(hooks)
+    try:
+        yield
+        device.synchronize()
+        protected = set()
+        for chunk in models:
+            for param in chunk.parameters():
+                protected.add(param.untyped_storage().data_ptr())
+                for grad in (param.grad, getattr(param, "main_grad", None)):
+                    if grad is not None:
+                        protected.add(grad.untyped_storage().data_ptr())
+        seen = set()
+        released = 0
+        for reference in tracked:
+            storage = torch.UntypedStorage._new_with_weak_ptr(reference.cdata)
+            if storage is None:
+                continue
+            pointer = storage.data_ptr()
+            if pointer in protected or pointer in seen or not storage.nbytes():
+                continue
+            seen.add(pointer)
+            released += storage.nbytes()
+            storage.resize_(0)
+        if released:
+            device.empty_cache()
+        if torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
+            print(f"[deepseek4-memory] completed_checkpoint_inputs_released_bytes={released}", flush=True)
+    finally:
+        for handle in hooks:
+            handle.remove()
+        tracked.clear()
+        _CHECKPOINT_HOOKS.reset(hook_token)
+        _CHECKPOINT_INPUTS.reset(token)
+
+
+def configure_rope_cache(models, max_sequence_length):
+    """Size deterministic RoPE tables for the current packed sequence, growing as needed."""
+    from megatron.core.parallel_state import get_context_parallel_world_size
+
+    for chunk in models:
+        for model in chunk.modules():
+            if getattr(model, "position_embedding_type", None) != "deepseek4":
+                continue
+            original = model.rotary_pos_emb
+            original_forward = model.forward
+            model._verl_rope_length = max_sequence_length
+
+            @functools.wraps(original)
+            def rotary(dim, seqlen, *args, _original=original, _model=model, **kwargs):
+                return _original(dim, min(seqlen, _model._verl_rope_length), *args, **kwargs)
+
+            model.rotary_pos_emb = rotary
+
+            @functools.wraps(original_forward)
+            def forward(*args, _original=original_forward, _model=model, **kwargs):
+                packed = kwargs.get("packed_seq_params")
+                if packed is not None:
+                    cumulative = packed.cu_seqlens_q
+                    required = int(cumulative[-1].item())
+                else:
+                    inputs = kwargs.get("decoder_input")
+                    if inputs is None:
+                        inputs = kwargs.get("input_ids", args[0] if args else None)
+                    required = inputs.numel() if inputs is not None else max_sequence_length
+                    required *= get_context_parallel_world_size()
+                if required > _model._verl_rope_length:
+                    _model._verl_rope_length = required
+                    _model.rotary_pos_emb_cache.clear()
+                return _original(*args, **kwargs)
+
+            model.forward = forward
+
+
+def clear_rope_cache(models):
+    """Drop ordinary RoPE attributes and global tables when a model is offloaded."""
+    for chunk in models:
+        for module in chunk.modules():
+            cache = getattr(module, "rotary_pos_emb_cache", None)
+            if isinstance(cache, dict):
+                cache.clear()
+            if hasattr(module, "freqs_cis"):
+                module.freqs_cis = None
+    module = sys.modules.get("mindspeed_llm.core.models.common.embeddings.rotary_pos_embedding")
+    if module is not None:
+        cache = getattr(module, "_DEEPSEEK4_ROPE_TABLE_CACHE", None)
+        if isinstance(cache, dict):
+            cache.clear()
