diff --git a/verl/workers/engine/mindspeed/deepseek4_memory.py b/verl/workers/engine/mindspeed/deepseek4_memory.py
new file mode 100644
index 0000000000000000000000000000000000000000..23878a11eea903f8df68e21b2bedf10a027fc6c5
--- /dev/null
+++ b/verl/workers/engine/mindspeed/deepseek4_memory.py
@@ -0,0 +1,167 @@
