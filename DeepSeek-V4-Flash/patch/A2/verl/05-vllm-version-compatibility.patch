-
     patch_vllm013_rotary_emb()
-    _patch_legacy_fused_moe_weight_loader(FusedMoE)
+
+    # The FusedMoE transpose wrapper is only valid for legacy vLLM (<0.15);
+    # on newer vLLM it scrambles NPU MoE weights (train/rollout kl ~= 1.85 on DSV4).
+    import vllm
+    from packaging import version
+
+    if version.parse(vllm.__version__) >= version.parse("0.30.0"):
+        patch_vllm_ascend_optional_gdn()
+
+    if version.parse(vllm.__version__) < version.parse("0.15.0"):
+        from vllm.model_executor.layers.fused_moe import FusedMoE
+
+        _patch_legacy_fused_moe_weight_loader(FusedMoE)
