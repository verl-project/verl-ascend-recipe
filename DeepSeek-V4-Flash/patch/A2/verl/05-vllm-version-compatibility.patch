 # limitations under the License.
 
 
+import importlib
+import logging
+import sys
+from contextlib import contextmanager
 from functools import wraps
+from types import ModuleType
 
 from verl.utils.device import is_torch_npu_available
 
 
+_QWEN35_WORKER_PATCH = "vllm_ascend.patch.worker.patch_qwen3_5"
+_ASCEND_GDN_OPS = "vllm_ascend.ops.gdn"
+logger = logging.getLogger(__name__)
+
+@contextmanager
+def _without_unavailable_gdn_imports():
+    """Let unrelated Ascend worker patches initialize without optional GDN."""
+    from vllm.model_executor.custom_op import op_registry_oot
+
+    missing = object()
+    previous_modules = {
+        name: sys.modules.get(name, missing) for name in (_QWEN35_WORKER_PATCH, _ASCEND_GDN_OPS)
+    }
+
+    qwen_patch_stub = ModuleType(_QWEN35_WORKER_PATCH)
+    gdn_stub = ModuleType(_ASCEND_GDN_OPS)
+    unavailable_gdn = type("_UnavailableQwen35GatedDeltaNetAttention", (), {})
+    gdn_stub.AscendGatedDeltaNetAttention = unavailable_gdn
+    sys.modules[_QWEN35_WORKER_PATCH] = qwen_patch_stub
+    sys.modules[_ASCEND_GDN_OPS] = gdn_stub
+
+    try:
+        yield
+    finally:
+        try:
+            import vllm_ascend.utils as ascend_utils
+
+            if ascend_utils.REGISTERED_ASCEND_OPS.get("GatedDeltaNetAttention") is unavailable_gdn:
+                ascend_utils.REGISTERED_ASCEND_OPS.pop("GatedDeltaNetAttention")
+        except (AttributeError, ImportError):
+            pass
+        if op_registry_oot.get("GatedDeltaNetAttention") is unavailable_gdn:
+            op_registry_oot.pop("GatedDeltaNetAttention")
+        for name, previous in previous_modules.items():
+            if previous is missing:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = previous
+
+def patch_vllm_ascend_optional_gdn() -> bool:
+    """Warn and skip GDN registration when its optional dependencies are absent."""
+    import vllm_ascend.utils as ascend_utils
+
+    original_adapt_patch = ascend_utils.adapt_patch
+    if getattr(original_adapt_patch, "_verl_optional_gdn_patched", False):
+        return False
+
+    gdn_available = None
+
+    def has_gdn_support():
+        nonlocal gdn_available
+        if gdn_available is None:
+            try:
+                importlib.import_module(_ASCEND_GDN_OPS)
+                gdn_available = True
+            except ImportError as error:
+                gdn_available = False
+                logger.warning(
+                    "GDN support is unavailable (%s); skipping the Qwen3.5 GDN worker patch "
+                    "and GatedDeltaNetAttention registration.",
+                    error,
+                )
+        return gdn_available
+
+    @wraps(original_adapt_patch)
+    def adapt_patch(is_global_patch=False):
+        if is_global_patch or has_gdn_support():
+            return original_adapt_patch(is_global_patch=is_global_patch)
+        with _without_unavailable_gdn_imports():
+            return original_adapt_patch(is_global_patch=False)
+
+    original_register_customop = ascend_utils.register_ascend_customop
+
+    @wraps(original_register_customop)
+    def register_ascend_customop(vllm_config=None):
+        if has_gdn_support():
+            return original_register_customop(vllm_config)
+        with _without_unavailable_gdn_imports():
+            return original_register_customop(vllm_config)
+
+    adapt_patch._verl_optional_gdn_patched = True
+    register_ascend_customop._verl_optional_gdn_patched = True
+    ascend_utils.adapt_patch = adapt_patch
+    ascend_utils.register_ascend_customop = register_ascend_customop
+
+    # NPUWorker imports this function at module scope. Rebind the saved alias
+    # when vLLM resolved the worker class before importing VERL's extension.
+    worker_module = sys.modules.get("vllm_ascend.worker.worker")
+    if worker_module is not None:
+        worker_module.register_ascend_customop = register_ascend_customop
+    return True
+
 def vllm_v013_weight_loader_method_wrapper(fn):
     @wraps(fn)
     def wrapper(self, param, loaded_weight, weight_name, shard_id, expert_id, return_success=False):
