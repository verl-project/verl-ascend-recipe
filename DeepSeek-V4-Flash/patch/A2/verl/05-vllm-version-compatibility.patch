+"""Reload initialized Ascend BF16 experts without changing their inference layout."""
+
+import importlib
+from functools import wraps
+
+def _get_unquantized_fused_moe_method():
+    new_module_name = "vllm.model_executor.layers.fused_moe.unquantized_fused_moe_method"
+    try:
+        module = importlib.import_module(new_module_name)
+    except ModuleNotFoundError as error:
+        # Fall back only for vLLM versions predating the module split. Missing
+        # dependencies inside the new module must remain visible.
+        if error.name != new_module_name:
+            raise
+        module = importlib.import_module("vllm.model_executor.layers.fused_moe.layer")
+    return module.UnquantizedFusedMoEMethod
+
+def _transpose_weight_loader(weight_loader):
+    @wraps(weight_loader)
+    def load_weight(param, loaded_weight, *args, **kwargs):
+        # is_transposed tells vLLM to shard along the transposed intermediate
+        # dimension. Keep its expert mapping and TP slicing intact.
+        return weight_loader(param, loaded_weight.transpose(-1, -2).contiguous(), *args, **kwargs)
+
+    load_weight._verl_ascend_transposed = True
+    return load_weight
+
+
+def _keep_inference_layout(layer):
+    # Initial model loading has already padded/transposed these weights. Reloads
+    # write directly into that storage, including the storage captured by ACL graphs.
+    return None
+
+
+def patch_ascend_moe_weight_loading(model):
+    """Patch an *initialized* Ascend model for repeated unquantized MoE reloads.
+
+    Ascend's initial post-processing transposes w13/w2 from checkpoint layout
+    into the layout used by grouped matmul. vLLM's ordinary loader otherwise
+    writes subsequent HF weights into the wrong axes. In particular, square
+    w13 matrices can silently load incorrectly while rectangular w2 fails.
+
+    Call after the generic MoE loader patch, which can replace weight_loader.
+    Only the expert post-processing is skipped; linear/attention post-processing
+    must still run to refresh derived weights such as DeepSeek's FP32 copies.
+    """
+    unquantized_fused_moe_method = _get_unquantized_fused_moe_method()
+
+    for module in model.modules():
+        quant_method = getattr(module, "quant_method", None)
+        if not isinstance(quant_method, unquantized_fused_moe_method):
+            continue
+
+        # New vLLM keeps these on RoutedExperts under MoERunner. Inspect direct
+        # parameters so forwarded properties on the parent do not patch twice.
+        params = dict(module.named_parameters(recurse=False))
+        if not all(name in params for name in ("w13_weight", "w2_weight")):
+            continue
+
+        for name in ("w13_weight", "w2_weight"):
+            param = params[name]
+            weight_loader = getattr(param, "weight_loader", None) or module.weight_loader
+            if not getattr(weight_loader, "_verl_ascend_transposed", False):
+                param.weight_loader = _transpose_weight_loader(weight_loader)
+            param.is_transposed = True
+
+        quant_method.process_weights_after_loading = _keep_inference_layout
