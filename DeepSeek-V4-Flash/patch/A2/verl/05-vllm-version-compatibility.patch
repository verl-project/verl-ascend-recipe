+import asyncio
+
+from vllm.v1.engine.async_llm import AsyncLLM
+
+
+class PauseAwareAsyncLLM(AsyncLLM):
+    """Block request admission across rollout pause and weight updates.
+
+    Recent vLLM versions pause scheduling but still enqueue new requests.
+    Partial-rollout retries can then register requests after the abort and
+    restart the DP coordinator's running flag while the engines stay paused.
+    Serialize the short request submission with pause, keeping retries outside
+    both the output processor and EngineCore until generation resumes.
+    """
+
+    def __init__(self, *args, **kwargs):
+        self._admission_lock = asyncio.Lock()
+        self._generation_lifecycle_lock = asyncio.Lock()
+        self._generation_resumed = asyncio.Event()
+        self._generation_resumed.set()
+        self._pause_drained = False
+        super().__init__(*args, **kwargs)
+
+    async def _add_request(self, *args, **kwargs):
+        # Guard the point that registers output state and submits to EngineCore,
+        # including child requests and streaming input. Never hold this lock
+        # while waiting for generated tokens.
+        while True:
+            await self._generation_resumed.wait()
+            async with self._admission_lock:
+                # Pause may have closed admission while we waited for the lock.
+                if not self._generation_resumed.is_set():
+                    continue
+                return await super()._add_request(*args, **kwargs)
+
+    async def pause_generation(self, **kwargs):
+        """Close admission and wait for the engine's pause acknowledgement."""
+        async with self._generation_lifecycle_lock:
+            self._generation_resumed.clear()
+            self._pause_drained = False
+            async with self._admission_lock:
+                await super().pause_generation(**kwargs)
+                self._pause_drained = kwargs.get("mode", "abort") != "keep"
+
+    async def resume_generation(self):
+        """Reopen admission after the engine has resumed successfully."""
+        async with self._generation_lifecycle_lock:
+            await super().resume_generation()
+            self._pause_drained = False
+            self._generation_resumed.set()
+
+    async def wait_for_requests_to_drain(self, *args, **kwargs):
+        """Reuse a completed pause barrier or drain an unpaused engine."""
+        # A completed abort/wait pause is already a barrier across DP engines.
+        # The coordinator's asynchronous running flag can be stale; polling it
+        # again after pause adds no safety and can time out on idle engines.
+        if self._pause_drained:
+            return
+        await super().wait_for_requests_to_drain(*args, **kwargs)
