     pp_group = mpu.get_pipeline_model_parallel_group()
     world_size = torch.distributed.get_world_size(pp_group)
-    if local_layers_router_map.is_nested:
+    # mindspeed-llm's num_layer_list assigns a different number of layers to
+    # each pipeline stage, so local router maps cannot be all_gathered with
+    # identical shapes. Fall back to all_gather_object; concatenation in
+    # pp_rank order already matches the global layer ordering.
+    num_layer_list = _resolve_num_layer_list(tf_config)
+    non_uniform_pp = num_layer_list is not None and len(set(num_layer_list)) > 1
