             # recording at the last generation. Trailing rows stay zero; replay masks
             # them out instead of consuming them.
             total_length = output["prompts"].size(0) + output["responses"].size(0)
+            # R3 fix 30: only total_length or total_length - 1 rows are legal (the last
+            # sampled token never enters the model). Fewer rows mean the rollout lost
+            # routes; left-aligning would shift every following token's routes.
+            num_rows = routed_experts.size(0)
+            if num_rows not in (total_length, total_length - 1):
+                import os as _r3_rows_os
+
+                _r3_rows_msg = (
+                    f"as_dict: routed_experts has {num_rows} rows, expected "
+                    f"{total_length - 1} or {total_length} "
+                    f"(prompt={output['prompts'].size(0)}, response={output['responses'].size(0)})"
+                )
+                if _r3_rows_os.environ.get("VERL_R3_ALLOW_SHORT_REPLAY", "0") == "1":
+                    print(f"[R3ROWS] WARNING {_r3_rows_msg}", flush=True)
+                else:
+                    raise RuntimeError(_r3_rows_msg)
             aligned = routed_experts.new_zeros((total_length, *routed_experts.shape[1:]))
-            num_rows = min(routed_experts.size(0), total_length)
+            num_rows = min(num_rows, total_length)
             aligned[:num_rows] = routed_experts[:num_rows]
             output["routed_experts"] = aligned
 
