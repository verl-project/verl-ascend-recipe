         self._full_determinism = full_determinism
+        # Closed only across validation. Train partial-rollout retries poll this
+        # instead of entering vLLM, so validation has the engine to itself.
+        self._train_admission_open = True
+        self._hold_started: Optional[float] = None
+        self._hold_wait_logged = False
+        self._train_admission_waiters: set[str] = set()
+        self._train_release_pending: Optional[set[str]] = None
+        self._train_release_completed: set[str] = set()
+
+    def hold_train_admission(self) -> None:
+        """Stop train generation retries from entering vLLM until release."""
+        self._train_admission_open = False
+        self._hold_started = time.monotonic()
+        self._hold_wait_logged = False
+        self._train_admission_waiters.clear()
+        self._train_release_pending = None
+        self._train_release_completed.clear()
+
+    def begin_train_admission_release(self) -> None:
+        """Snapshot requests that must be added to vLLM before scheduling resumes."""
+        self._train_release_pending = set(self._train_admission_waiters)
+        self._train_release_completed.clear()
+
+    def release_train_admission(self) -> None:
+        """Allow train generation retries into vLLM again."""
+        self._train_admission_open = True
+        self._hold_started = None
+        self._hold_wait_logged = False
+
+    def train_admission_open(self, request_id: Optional[str] = None) -> tuple[bool, Optional[float]]:
+        """Whether train retries may enter vLLM, plus a one-shot hold age.
+
+        The age is seconds since this hold began, returned once after 60s and
+        then ``None`` until the next ``hold_train_admission``. The clock lives
+        here so an ``admission_closed`` retry cannot reset it.
+        """
+        if request_id is not None:
+            if not self._train_admission_open:
+                self._train_admission_waiters.add(request_id)
+            elif self._train_release_pending is not None and request_id not in self._train_release_completed:
+                # A late retry from the held set still joins the release barrier.
+                # The next train batch is not submitted until the barrier finishes.
+                self._train_release_pending.add(request_id)
+        notice: Optional[float] = None
+        if not self._train_admission_open and not self._hold_wait_logged and self._hold_started is not None:
+            elapsed = time.monotonic() - self._hold_started
+            if elapsed >= 60.0:
+                self._hold_wait_logged = True
+                notice = elapsed
+        return self._train_admission_open, notice
+
+    def train_admission_queued(self, request_id: str) -> None:
+        """Record that AsyncLLM.add_request has submitted this request to EngineCore."""
+        if self._train_release_pending is None or request_id not in self._train_release_pending:
+            return
+        self._train_release_pending.remove(request_id)
+        self._train_release_completed.add(request_id)
+
+    def train_admission_release_status(self) -> tuple[int, int]:
+        """Return (pending, completed) request counts for the release barrier."""
+        return len(self._train_release_pending or ()), len(self._train_release_completed)
+
+    def finish_train_admission_release(self) -> None:
+        """Clear release-barrier state after scheduling resumes."""
+        self._train_admission_waiters.clear()
+        self._train_release_pending = None
+        self._train_release_completed.clear()
 
