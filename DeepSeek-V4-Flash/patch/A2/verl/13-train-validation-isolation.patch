+    def _release_train_admission(self) -> None:
+        """Requeue held train requests before admitting the next fresh batch.
+
+        The next ``_add_batch_to_generate`` runs only after this method returns, so
+        the engine does not need to be paused here. Keeping it running avoids a DP
+        engine path where ``add_request`` would not complete while paused, leaving
+        every held request without an acknowledgment.
+
+        The load balancer tracks held vLLM request IDs and each server acknowledges
+        after ``AsyncLLM.add_request`` submits the request. The barrier is fail-open
+        by default: a missing acknowledgment must not kill a training run. Set
+        ``VERL_R3_VAL_RELEASE_STRICT=1`` to restore the hard failure for debugging.
+        """
+        if not getattr(self, "_train_admission_held", False):
+            return
+        self._train_admission_held = False
+        self._isolate_train_during_validation = False
+        logger.info("Releasing in-flight train generation after validation")
+        pending_exception = sys.exc_info()[0] is not None
+        release_error: Optional[BaseException] = None
+        load_balancer = getattr(getattr(self, "llm_server_manager", None), "global_load_balancer", None)
+        strict = os.environ.get("VERL_R3_VAL_RELEASE_STRICT", "0") == "1"
+        no_ack_grace_s = float(os.environ.get("VERL_R3_VAL_RELEASE_NO_ACK_GRACE_S", "10"))
+
+        try:
+            if load_balancer is None:
+                raise RuntimeError("validation release ordering requires the global load balancer")
+            self.checkpoint_manager.prepare_train_admission_release(load_balancer)
+            ray.get(load_balancer.begin_train_admission_release.remote())
+
+            # Open the server before the client poll, so a retry cannot observe an
+            # open poll and then get rejected. The engine stays running so that the
+            # held requests can reach AsyncLLM.add_request and acknowledge.
+            self.checkpoint_manager.release_train_admission()
+            ray.get(load_balancer.release_train_admission.remote())
+
+            timeout_s = float(os.environ.get("VERL_R3_VAL_RELEASE_TIMEOUT_S", "60"))
+            started = time.monotonic()
+            deadline = started + timeout_s
+            last_log = 0.0
+            empty_since = None
+            while True:
+                pending, completed = ray.get(load_balancer.train_admission_release_status.remote())
+                now = time.monotonic()
+                if pending == 0:
+                    if empty_since is None:
+                        empty_since = now
+                    # Match the client's maximum 5s backoff plus 20% jitter.
+                    # A late held retry can still join the barrier during this window.
+                    if now - empty_since >= 6.0:
+                        logger.info("[R3VAL] release barrier: all %d held requests added", completed)
+                        break
+                else:
+                    empty_since = None
+                # No acknowledgment at all usually means this vLLM build does not
+                # route generate() through the patched add_request, or the held
+                # waiters no longer exist. Both are non-fatal; let training proceed.
+                if not strict and completed == 0 and now - started >= no_ack_grace_s:
+                    logger.warning(
+                        "[R3VAL] release barrier saw no add_request acknowledgment after %.0fs "
+                        "(pending=%d); proceeding without strict ordering",
+                        now - started,
+                        pending,
+                    )
+                    break
+                if now >= deadline:
+                    message = (
+                        f"validation release barrier timed out after {timeout_s:.0f}s: "
+                        f"pending={pending} completed={completed}"
+                    )
+                    if strict:
+                        raise TimeoutError(message)
+                    logger.warning("[R3VAL] %s; proceeding without strict ordering", message)
+                    break
+                if now - last_log >= 5.0:
+                    logger.info("[R3VAL] release barrier: completed=%d pending=%d", completed, pending)
+                    last_log = now
+                time.sleep(0.1)
+        except Exception as exc:
+            logger.exception("Failed to preserve train-request order after validation")
+            release_error = exc
+        finally:
+            # Always recover to an open, schedulable state. If this release was
+            # already handling an exception, cleanup must not replace it.
+            def cleanup(description, fn):
+                nonlocal release_error
+                try:
+                    fn()
+                except Exception as exc:
+                    logger.exception("Failed to %s", description)
+                    if release_error is None:
+                        release_error = exc
+
+            cleanup("release server train admission", self.checkpoint_manager.release_train_admission)
+            if load_balancer is not None:
+                cleanup(
+                    "release load-balancer train admission",
+                    lambda: ray.get(load_balancer.release_train_admission.remote()),
+                )
+            cleanup("resume generation after validation", self.checkpoint_manager.resume_generation_replicas)
+            cleanup(
+                "remove validation release hooks",
+                self.checkpoint_manager.complete_train_admission_release,
+            )
+            if load_balancer is not None:
+                cleanup(
+                    "clear validation release barrier",
+                    lambda: ray.get(load_balancer.finish_train_admission_release.remote()),
+                )
+
+        if release_error is not None and not pending_exception:
+            raise release_error
+
