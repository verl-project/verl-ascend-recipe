     def on_sample_end(self):
+        # On a validation step, close train admission before abort. Partial-rollout
+        # retries then wait outside the engine; validation requests pass the gate.
+        # fit() opens the gate again after _validate().
+        # parameter_sync_step > 1 samples again inside this step. Hold only on the
+        # last trigger, after which on_step_end resumes the engine for validation.
+        is_last_trigger = self.local_trigger_step >= self.parameter_sync_step - 1
+        if getattr(self, "_isolate_train_during_validation", False) and is_last_trigger:
+            load_balancer = getattr(self.llm_server_manager, "global_load_balancer", None)
+            if load_balancer is None:
+                raise RuntimeError(
+                    "colocate_async cannot hold train generation across validation "
+                    "without the global load balancer"
+                )
+            self._train_admission_held = True
+            logger.info(
+                "Holding in-flight train generation until validation finishes. "
+                "After release, step sample waits for the remaining generation; "
+                "that extra wall time is the cost of keeping validation off this batch."
+            )
+            # Close the client-side poll first, then the server reject, then abort.
+            ray.get(load_balancer.hold_train_admission.remote())
+            self.checkpoint_manager.hold_train_admission()
         # abort all unfinished requests and pause generation
         self.checkpoint_manager.abort_replicas()
         # sleep all replicas to discard weights and kv cache
