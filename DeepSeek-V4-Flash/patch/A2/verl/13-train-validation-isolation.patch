+    def _sample_val_with_heartbeat(self, batch_size: int):
+        """Block on the val partition and log while it is still outstanding.
+
+        A healthy validation already waits tens of minutes for generation, so the
+        line is a heartbeat, not a fault. If it keeps printing and ``_validate``
+        never returns, the val requests are not finishing. One cause is a custom
+        agent loop that received ``validate`` but did not forward it to ``generate``.
+        """
+        stop = threading.Event()
+        started = time.monotonic()
+
+        def _heartbeat() -> None:
+            while not stop.wait(300):
+                logger.info("[R3VAL] waiting %.0fs for val samples", time.monotonic() - started)
+
+        beater = threading.Thread(target=_heartbeat, name="r3val-sample-heartbeat", daemon=True)
+        beater.start()
+        try:
+            return self.replay_buffer.sample(
+                global_steps=self.global_steps, partition_id="val", batch_size=batch_size
+            )
+        finally:
+            stop.set()
+            beater.join(timeout=1.0)
+
     def _validate(self) -> dict[str, float]:
         # Lists to collect samples for the table
         sample_uids = []
