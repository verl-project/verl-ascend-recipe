+class _PrefixPageCacheReleaser:
+    """Drop clean page-cache pages that checkpoint loading has finished reading.
+
+    ``posix_fadvise(DONTNEED)`` is applied only to ``[released, until)`` after
+    that prefix is no longer referenced by a later read item. The length is the
+    byte count, not an end offset. A partial trailing page is left in place so
+    the next tensor, which may share that page, is not evicted.
+
+    This does not advise the whole file (``len=0``). Doing so also drops
+    readahead of the next tensor. ``POSIX_FADV_SEQUENTIAL`` / ``NOREUSE`` are
+    not set: the former widens readahead, and Linux ignores the latter.
+    """
+
+    def __init__(self, stream, chunk, path):
+        self._fd = stream.fileno()
+        self._chunk = chunk
+        self._path = path
+        self._released = 0
+        self._advises = 0
+        self._bytes = 0
+        self._failed = False
+        self._announced = False
+
+    def release_until(self, until):
+        if self._failed or self._chunk <= 0:
+            return
+        until_aligned = until - (until % _PAGE_BYTES)
+        pos = self._released
+        if until_aligned <= pos:
+            return
+        try:
+            while pos < until_aligned:
+                step = min(self._chunk, until_aligned - pos)
+                os.posix_fadvise(self._fd, pos, step, os.POSIX_FADV_DONTNEED)
+                pos += step
+                self._advises += 1
+                self._bytes += step
+        except OSError as exc:
+            self._failed = True
+            print(f"[CKPT-READ] fadvise failed: {exc}", flush=True)
+            return
+        self._released = pos
+        if not self._announced:
+            self._announced = True
+            print(
+                f"[CKPT-READ] streaming fadvise on, chunk={self._chunk} file={self._path}",
+                flush=True,
+            )
+
+    def close_log(self):
+        print(
+            f"[CKPT-READ] close advises={self._advises} released={self._bytes} file={self._path}",
+            flush=True,
+        )
