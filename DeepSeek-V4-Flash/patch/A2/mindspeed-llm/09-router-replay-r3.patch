+
+                replay_action = router_replay.router_replay_action
+                replay_forward_or_backward = replay_action in (
+                    RouterReplayAction.REPLAY_FORWARD,
+                    RouterReplayAction.REPLAY_BACKWARD,
+                )
+
+            # R3 31: hash routing is the deterministic tid2eid lookup, so replaying
+            # it is an identity transform (17/25 measured agree=1.0). Keep the native
+            # branch instead: it removes a replay path that can be poisoned by
+            # capture-side row loss (see dsv4_r3_issue.md P4) at zero numerical cost.
+            replay_forward_or_backward = False
+
             input_ids = input_ids.flatten()
             # support tp
             tp_size = parallel_state.get_tensor_model_parallel_world_size()
             tp_rank = parallel_state.get_tensor_model_parallel_rank()
             input_ids = input_ids.chunk(tp_size)[tp_rank]
