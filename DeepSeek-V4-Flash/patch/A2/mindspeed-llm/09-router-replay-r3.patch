+    router_replay=None,
 ):
     """
     patch hash operator in megatron topk_softmax_with_capacity
@@ -115,7 +116,7 @@ def topk_softmax_with_capacity_and_hash(
     assert logits.dim() == 2, f"Expected 2D logits [num_tokens, num_experts], got {logits.dim()}."
     num_tokens, num_experts = logits.shape
 
-    def compute_topk(scores, topk, num_groups=None, group_topk=None):
+    def _compute_topk(scores, topk, num_groups=None, group_topk=None):
         if group_topk:
             return group_limited_topk(
                 scores=scores,
@@ -128,6 +129,19 @@ def topk_softmax_with_capacity_and_hash(
         else:
             return torch.topk(scores, k=topk, dim=1)
 
+    def compute_topk(scores, topk, num_groups=None, group_topk=None):
+        if router_replay is None:
+            return _compute_topk(scores, topk, num_groups=num_groups, group_topk=group_topk)
+        # RECORD / REPLAY_FORWARD / REPLAY_BACKWARD are handled centrally by
+        # RouterReplay (including the R3 replay mask).
+        return router_replay.get_replay_topk(
+            scores,
+            topk,
+            num_groups=num_groups,
+            group_topk=group_topk,
+            default_compute_topk=_compute_topk,
+        )
+
     if score_function == "softmax":
         if use_pre_softmax:
             scores = torch.softmax(logits, dim=-1, dtype=torch.float32).type_as(logits)
@@ -152,16 +166,49 @@ def topk_softmax_with_capacity_and_hash(
             scores = torch.gather(scores, dim=1, index=top_indices).type_as(logits)
         # hash
         elif token_hash and tid2eid is not None and expert_bias is None:
+            replay_action = None
+            replay_forward_or_backward = False
+            if router_replay is not None:
+                from verl.utils.megatron.router_replay_patch import RouterReplayAction
+
+                replay_action = router_replay.router_replay_action
+                replay_forward_or_backward = replay_action in (
+                    RouterReplayAction.REPLAY_FORWARD,
+                    RouterReplayAction.REPLAY_BACKWARD,
+                )
+
+            # R3 31: hash routing is the deterministic tid2eid lookup, so replaying
+            # it is an identity transform (17/25 measured agree=1.0). Keep the native
+            # branch instead: it removes a replay path that can be poisoned by
+            # capture-side row loss (see dsv4_r3_issue.md P4) at zero numerical cost.
+            replay_forward_or_backward = False
+
             input_ids = input_ids.flatten()
             # support tp
             tp_size = parallel_state.get_tensor_model_parallel_world_size()
             tp_rank = parallel_state.get_tensor_model_parallel_rank()
             input_ids = input_ids.chunk(tp_size)[tp_rank]
-            top_indices = tid2eid[input_ids]  # [b * s / sp_size, top_k]
-            # print(f"[debug] top_indices shape is: {top_indices.shape}")
-            # print(f"[debug] top_indices is {top_indices}")
 
-            scores = torch.gather(scores, dim=1, index=top_indices).type_as(scores)
+            if replay_forward_or_backward:
+                # Replay rollout routes, but rows outside the replay mask must fall
+                # back to the token-id hash table, not the dense group_limited_topk.
+                def _hash_native_topk(_scores, _topk, num_groups=None, group_topk=None):
+                    _indices = tid2eid[input_ids]
+                    return torch.gather(_scores, dim=1, index=_indices).type_as(_scores), _indices
+
+                scores, top_indices = router_replay.get_replay_topk(
+                    scores,
+                    topk,
+                    num_groups=num_groups,
+                    group_topk=group_topk,
+                    default_compute_topk=_hash_native_topk,
+                )
+            else:
+                top_indices = tid2eid[input_ids]  # [b * s / sp_size, top_k]
+                if router_replay is not None and replay_action == RouterReplayAction.RECORD:
+                    router_replay.record_indices(top_indices)
+                scores = torch.gather(scores, dim=1, index=top_indices).type_as(scores)
+
             probs = scores / (scores.sum(dim=-1, keepdim=True) + 1e-20) if topk > 1 else scores
 
             if scaling_factor:
@@ -229,6 +276,7 @@ def topk_softmax_with_capacity(
