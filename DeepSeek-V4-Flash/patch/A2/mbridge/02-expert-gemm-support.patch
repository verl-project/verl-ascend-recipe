+    def _load_gemm_weights_over_etp(
+        self,
+        local_name: str,
+        mcore_weight: torch.Tensor,
+        param_to_load: torch.Tensor,
+    ) -> None:
+        if self.mpu.etp_size == 1:
+            param_to_load.copy_(mcore_weight.to(param_to_load.device))
+            return
+
+        etp_group = self.mpu.etp_group
+        if self.mpu.etp_rank == 0:
+            slices = self._iter_gemm_etp_slices(
+                local_name, mcore_weight.to(param_to_load.device)
+            )
+            local_slice = None
+            for rank, weight_slice in enumerate(slices):
+                weight_slice = weight_slice.to(
+                    device=param_to_load.device, dtype=param_to_load.dtype
+                ).contiguous()
+                if rank == 0:
+                    local_slice = weight_slice
+                else:
+                    torch.distributed.send(
+                        weight_slice,
+                        dst=torch.distributed.get_global_rank(etp_group, rank),
+                        group=etp_group,
+                    )
+            param_to_load.copy_(local_slice)
+        else:
+            torch.distributed.recv(
+                param_to_load,
+                src=torch.distributed.get_global_rank(etp_group, 0),
+                group=etp_group,
+            )
+
+    def _export_gemm_weights(
+        self, name: str, broad_pp_param: torch.Tensor
+    ) -> Generator[tuple[str, torch.Tensor], None, None]:
+        hf_experts_key = self._get_hf_experts_key()
+        if not hf_experts_key:
+            raise RuntimeError(f"Missing HF expert key for {name}")
+
+        if self.mpu.etp_size > 1:
+            etp_params = [
+                torch.empty_like(broad_pp_param) for _ in range(self.mpu.etp_size)
+            ]
+            torch.distributed.all_gather(
+                etp_params, broad_pp_param, group=self.mpu.etp_group
+            )
+            own_merged = self._weight_merge_across_tp(
+                name, etp_params, broad_pp_param
+            )
+            del etp_params
+        else:
+            own_merged = self._weight_merge_across_tp(
+                name, [broad_pp_param], broad_pp_param
+            )
+        self._empty_device_cache(broad_pp_param.device)
+
+        # Every rank in every EP group all_gathers each expert block and
+        # yields the full global expert sequence, so all ranks produce an
+        # identical weight-name stream (verl relies on this: each training
+        # rank streams independently to its paired inference engine).
+        num_experts_per_rank = self.config.num_moe_experts // self.mpu.ep_size
+
+        def splice_expert_id(hf_name: str, global_expert_id: int) -> str:
+            prefix, suffix = hf_name.split(hf_experts_key, 1)
+            suffix = suffix.split(".", 1)[1]
+            return f"{prefix}{hf_experts_key}{global_expert_id}.{suffix}"
+
+        for local_expert_id, block in enumerate(
+            self._iter_gemm_local_expert_blocks(name, own_merged)
+        ):
+            if self.mpu.ep_size > 1:
+                gathered = [
+                    torch.empty_like(block) for _ in range(self.mpu.ep_size)
+                ]
+                torch.distributed.all_gather(
+                    gathered, block.contiguous(), group=self.mpu.ep_group
+                )
+            else:
+                gathered = [block]
+            for ep_rank in range(self.mpu.ep_size):
+                global_expert_id = num_experts_per_rank * ep_rank + local_expert_id
+                for hf_names, hf_weights in self._iter_gemm_export_experts(
+                    name,
+                    gathered[ep_rank],
+                    num_experts_in_tensor=1,
+                    expert_offset=local_expert_id,
+                ):
+                    converted_names = [
+                        splice_expert_id(hf_name, global_expert_id)
+                        for hf_name in hf_names
+                    ]
+                    yield from zip(converted_names, hf_weights)
+            del gathered
+            self._empty_device_cache(broad_pp_param.device)
+
+        del own_merged
+        self._empty_device_cache(broad_pp_param.device)
+        npu = getattr(torch, "npu", None)
+        if broad_pp_param.device.type == "npu" and npu is not None:
+            npu.synchronize()
+
