+def _dsa_o_proj_weight_for_batch_matmul(
+    weight: torch.Tensor,
+    n_local_groups: int,
+    input_dim: int,
+) -> torch.Tensor:
+    """Return an A5 BF16 grouped weight in ``[groups, K, N]`` layout."""
+    if weight.dim() == 3:
+        if weight.shape[-2] == input_dim:
+            return weight
+        if weight.shape[-1] == input_dim:
+            return weight.transpose(-1, -2)
+        raise ValueError(
+            "DSA wo_a weight has no axis matching the input K dimension, "
+            f"got weight {tuple(weight.shape)} and K={input_dim}."
+        )
+    if weight.dim() != 2:
+        raise ValueError(f"DSA wo_a weight must be 2D or 3D, got shape {tuple(weight.shape)}.")
+    if weight.shape[0] == n_local_groups * input_dim:
+        return weight.view(n_local_groups, input_dim, -1)
+    if weight.shape[1] == input_dim:
+        return weight.view(n_local_groups, -1, input_dim).transpose(-1, -2)
+    raise ValueError(
+        "DSA wo_a weight cannot be reshaped to grouped [K, N], "
+        f"got weight {tuple(weight.shape)}, groups={n_local_groups}, K={input_dim}."
+    )
+
+
+def _dsa_o_proj_matmul(
+    o_proj_input: torch.Tensor,
+    weight: torch.Tensor,
+    n_local_groups: int,
+) -> torch.Tensor:
+    grouped_weight = _dsa_o_proj_weight_for_batch_matmul(weight, n_local_groups, o_proj_input.shape[-1])
+    return torch.matmul(o_proj_input.transpose(0, 1), grouped_weight).transpose(0, 1)
+
+
