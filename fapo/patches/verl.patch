new file mode 100644
index 00000000..59383add
--- /dev/null
+++ b/tests/utils/test_mcore_qkv_unfuse_on_cpu.py
@@ -0,0 +1,107 @@
+# Copyright 2026 Bytedance Ltd. and/or its affiliates
